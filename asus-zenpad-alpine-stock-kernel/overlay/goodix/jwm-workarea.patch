+
+   /* Reflow without MaximizeClient(), which raises and focuses the client.
+    * PlaceMaximizedClient() overwrites restore geometry, so save it here.
+    * Inactive desktops must not use the current desktop's struts.
+    */
+   for(x = 0; x < LAYER_COUNT; x++) {
+      ClientNode *np;
+      for(np = nodes[x]; np; np = np->next) {
+         BoundingBox before, restore;
+         unsigned int status;
+         if(!np->state.maxFlags || !IsClientOnCurrentDesktop(np)
+            || (np->state.status & STAT_FULLSCREEN)) {
+            continue;
+         }
+         before.x = np->x;
+         before.y = np->y;
+         before.width = np->width;
+         before.height = np->height;
+         restore.x = np->oldx;
+         restore.y = np->oldy;
+         restore.width = np->oldWidth;
+         restore.height = np->oldHeight;
+         status = np->state.status;
+         np->state.status &= ~STAT_SHADED;
+         PlaceMaximizedClient(np, np->state.maxFlags);
+         np->state.status = status;
+         np->oldx = restore.x;
+         np->oldy = restore.y;
+         np->oldWidth = restore.width;
+         np->oldHeight = restore.height;
+         if(before.x != np->x || before.y != np->y
+            || before.width != np->width || before.height != np->height) {
+            ResetBorder(np);
+            DrawBorder(np);
+            SendConfigureEvent(np);
+            RequirePagerUpdate();
+         }
+      }
+   }
+}
