diff --git a/apps/cat_classifier/SHADOW_PROTOCOL_SMALL.md b/apps/cat_classifier/SHADOW_PROTOCOL_SMALL.md
new file mode 100644
index 0000000..f8ede5a
--- /dev/null
+++ b/apps/cat_classifier/SHADOW_PROTOCOL_SMALL.md
@@ -0,0 +1,17 @@
+# MobileNetV3 Small follow-up shadow protocol
+
+Run an independent 48-hour window with a new experiment ID and the retrained
+MobileNetV3 Small model, including the 860 independently confirmed Empty crops.
+The persisted start, deadline and model checksum define the cohort. Run alongside
+the existing tracker and use only its saved Gemini decisions and prepared crops.
+
+The 160px screen accepts Empty only when all three frames score at least 0.99
+for Empty. Otherwise the 320px head accepts one named cat at 0.8 or above in the
+absence of a confident conflicting name. Three confident Empty frames give
+Empty. On abstention only, use the separately trained presence and identity
+heads with the same bundle rule. Evidence quality checks apply before screening.
+
+Keep the original observer's limits, read-only media, coverage checks, private
+image preservation, and independent shutdown guard. Review saved crops blinded
+to model outputs. Score Eli, Pixel, Empty, abstentions, comparable Gemini
+answers and correlated groups. The model has no visit or elimination authority.
diff --git a/apps/cat_classifier/cat_classifier/small.py b/apps/cat_classifier/cat_classifier/small.py
new file mode 100644
index 0000000..b6f668c
--- /dev/null
+++ b/apps/cat_classifier/cat_classifier/small.py
@@ -0,0 +1,105 @@
+"""Run the frozen Small bundle policy with one CPU inference session."""
+import hashlib
+import io
+import json
+import time
+
+from .runtime import LABELS, MAX_IMAGE_BYTES, MAX_PIXELS
+
+
+def one_frame(frames):
+    confident = [r['label'] for r in frames if r['confidence'] >= .8]
+    names = set(confident) & {'Eli', 'Pixel'}
+    if len(names) == 1:
+        return names.pop()
+    if len(confident) == 3 and set(confident) == {'Empty'}:
+        return 'Empty'
+    return 'Unknown'
+
+
+class SmallBundle:
+    def __init__(self, folder):
+        import numpy as np
+        import onnxruntime as ort
+
+        self.np = np
+        self.mean = np.array([.485, .456, .406], dtype=np.float32)
+        self.std = np.array([.229, .224, .225], dtype=np.float32)
+        path = folder/'model.onnx'
+        self.sha256 = hashlib.sha256(path.read_bytes()).hexdigest()
+        card = json.loads((folder/'model.json').read_text())
+        if (self.sha256 != card['sha256'] or card['labels'] != LABELS
+                or card['coarse_empty_threshold'] != .99
+                or card['fallback_logit_order'] != ['visible_cat', 'Pixel_given_visible_cat']):
+            raise ValueError('Unexpected Small model card or checksum')
+        options = ort.SessionOptions()
+        options.intra_op_num_threads = 1
+        options.inter_op_num_threads = 1
+        self.session = ort.InferenceSession(str(path), sess_options=options, providers=['CPUExecutionProvider'])
+        if {output.name for output in self.session.get_outputs()} != {'logits160', 'logits', 'fallback_logits'}:
+            raise ValueError('Unexpected Small model outputs')
+
+    def frame(self, image, payload, resolution):
+        from PIL import Image, ImageOps
+
+        begin = time.perf_counter()
+        crop = ImageOps.pad(image, (resolution, resolution), method=Image.Resampling.BICUBIC,
+                            color=(124,116,104))
+        normalized = (self.np.asarray(crop,dtype=self.np.float32)/255-self.mean)/self.std
+        tensor = self.np.transpose(normalized,(2,0,1))[None].copy()
+        prepared = time.perf_counter()
+        names = ['logits160'] if resolution == 160 else ['logits', 'fallback_logits']
+        values = self.session.run(names, {'image':tensor})
+        logits = values[0][0]
+        if logits.shape != (3,) or not self.np.isfinite(logits).all():
+            raise ValueError('Unexpected Small frame result')
+        p = self.np.exp(logits - logits.max())
+        p /= p.sum()
+        label = LABELS[int(p.argmax())]
+        result = {'label':label, 'confidence':float(p.max()),
+                  'probabilities':dict(zip(LABELS,map(float,p))),
+                  'model_sha256':self.sha256,'image_sha256':hashlib.sha256(payload).hexdigest(),
+                  'preprocess_seconds':prepared-begin, 'inference_seconds':time.perf_counter()-prepared,
+                  'scope':'frame_identity_presence_only','confidence_calibrated':False,
+                  'resolution':resolution}
+        fallback = None
+        if resolution == 320:
+            branch = values[1][0]
+            if branch.shape != (2,) or not self.np.isfinite(branch).all():
+                raise ValueError('Unexpected Small fallback result')
+            cat, pixel = 1/(1 + self.np.exp(-self.np.clip(branch,-80,80)))
+            if cat < .5:
+                fallback = {'label':'Empty','confidence':float(1-cat)}
+            else:
+                fallback = {'label':'Pixel' if pixel > .5 else 'Eli',
+                            'confidence':float(min(cat,max(pixel,1-pixel)))}
+            result['presence_identity_fallback'] = fallback
+        return result, fallback
+
+    def bundle(self,payloads):
+        from PIL import Image
+
+        if len(payloads) != 3:
+            raise ValueError('Expected three evidence frames')
+        decoded = []
+        for payload in payloads:
+            if not payload or len(payload) > MAX_IMAGE_BYTES:
+                raise ValueError('Invalid Small image length')
+            with Image.open(io.BytesIO(payload)) as source:
+                if source.format not in ('JPEG','PNG') or source.width*source.height > MAX_PIXELS:
+                    raise ValueError('Invalid Small image format or dimensions')
+                decoded.append(source.convert('RGB'))
+        screened = []
+        for image,payload in zip(decoded,payloads,strict=True):
+            frame,_ = self.frame(image,payload,160)
+            if frame['label'] != 'Empty' or frame['confidence'] < .99:
+                break
+            screened.append(frame)
+        else:
+            return 'Empty', screened, 'screen_160'
+        frames,fallback = zip(*(self.frame(image,payload,320)
+                                for image,payload in zip(decoded,payloads,strict=True)),strict=True)
+        answer = one_frame(frames)
+        if answer == 'Unknown':
+            return one_frame(fallback), frames, 'presence_identity_320'
+        return answer, frames, 'primary_320'
