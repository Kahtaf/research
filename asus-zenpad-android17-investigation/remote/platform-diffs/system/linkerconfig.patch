diff --git a/contents/namespace/systemdefault.cc b/contents/namespace/systemdefault.cc
index 842fd83..c25a827 100644
--- a/contents/namespace/systemdefault.cc
+++ b/contents/namespace/systemdefault.cc
@@ -95,8 +95,23 @@ Namespace BuildSystemDefaultNamespace([[maybe_unused]] const Context& ctx) {
 
   SetupSystemPermittedPaths(&ns);
 
+  if (ctx.IsDefaultConfig() && modules::IsP00aLegacyGraphics()) {
+    // Pre-Treble graphics use one core ABI. Core paths stay first, with vendor
+    // paths retained for the current HIDL passthrough adapters and EGL alias.
+    ns.AddSearchPath("/vendor/${LIB}");
+    ns.AddSearchPath("/vendor/${LIB}/hw");
+    ns.AddPermittedPath("/system/${LIB}/egl");
+    ns.AddPermittedPath("/vendor/${LIB}");
+    ns.AddPermittedPath("/system/vendor/${LIB}");
+  }
+
   ns.AddRequires(ctx.GetSystemRequireLibs());
-  ns.AddProvides(ctx.GetSystemProvideLibs());
+  // The legacy vendor default shares core search paths, but BuildVendorSection
+  // also creates the system namespace, which owns the SYSTEM provider records.
+  if (!(ctx.IsDefaultConfig() && ctx.IsVendorSection() &&
+        modules::IsP00aLegacyGraphics())) {
+    ns.AddProvides(ctx.GetSystemProvideLibs());
+  }
   return ns;
 }
 
