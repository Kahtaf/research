diff --git a/modules/environment.cc b/modules/environment.cc
index 559a5ec..8a58f04 100644
--- a/modules/environment.cc
+++ b/modules/environment.cc
@@ -17,6 +17,7 @@
 #include "linkerconfig/environment.h"
 
 #include <unistd.h>
+#include <android-base/parseint.h>
 
 #include "linkerconfig/variables.h"
 
@@ -24,6 +25,19 @@ namespace android {
 namespace linkerconfig {
 namespace modules {
 
+bool IsP00aLegacyGraphics() {
+#ifdef P00A_LEGACY_GRAPHICS
+  unsigned int first_api = 0;
+  return android::base::ParseUint(
+             Variables::GetValue("ro.product.first_api_level").value_or(""),
+             &first_api) &&
+         first_api > 0 && first_api < 26 &&
+         !IsVendorVndkVersionDefined() && !IsProductVndkVersionDefined();
+#else
+  return false;
+#endif
+}
+
 bool IsVndkLiteDevice() {
   return Variables::GetValue("ro.vndk.lite").value_or("") == "true";
 }
