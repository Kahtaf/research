# Compile with the parent product policy; no permissive domain or blanket grants.
type p00a_radio, domain;
type p00a_radio_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(p00a_radio)
type p00a_radio_device, dev_type;
type p00a_radio_firmware_file, vendor_file_type, file_type;
type p00a_stpbt_device, dev_type;
type p00a_radio_socket, file_type;
type p00a_radio_nvram_file, file_type, data_file_type;
type p00a_bt_address_file, file_type, data_file_type;
vendor_internal_prop(p00a_radio_prop)
set_prop(p00a_radio, p00a_radio_prop)
get_prop(hal_bluetooth_default, p00a_radio_prop)
allow p00a_radio p00a_radio_device:chr_file rw_file_perms;
allow hal_bluetooth_default p00a_stpbt_device:chr_file rw_file_perms;
allow p00a_radio p00a_radio_nvram_file:dir r_dir_perms;
allow p00a_radio p00a_radio_nvram_file:file r_file_perms;
allow hal_bluetooth_default p00a_radio_nvram_file:dir search;
allow hal_bluetooth_default p00a_radio_nvram_file:file r_file_perms;
allow p00a_radio p00a_radio_firmware_file:dir r_dir_perms;
allow p00a_radio p00a_radio_firmware_file:file r_file_perms;
allow kernel p00a_radio_firmware_file:dir search;
allow kernel p00a_radio_firmware_file:file r_file_perms;
allow p00a_radio p00a_bt_address_file:dir rw_dir_perms;
allow p00a_radio p00a_bt_address_file:file create_file_perms;
allow hal_bluetooth_default p00a_bt_address_file:dir search;
allow hal_bluetooth_default p00a_bt_address_file:file r_file_perms;
allow p00a_radio p00a_radio_socket:sock_file rw_file_perms;
allow p00a_radio self:unix_stream_socket create_stream_socket_perms;
allow p00a_radio self:unix_stream_socket connectto;
allow p00a_radio toolbox_exec:file { rx_file_perms execute_no_trans };
allow p00a_radio sysfs_net:dir r_dir_perms;
allow p00a_radio sysfs_net:lnk_file read;
allow p00a_radio sysfs_net:file r_file_perms;
