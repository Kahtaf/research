+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef MT8163_CODEC_STATE_CONTROLS_H
+#define MT8163_CODEC_STATE_CONTROLS_H
+
+/* Control entry points serialize the entire call, including nested analog access. */
+#define CODEC_STATE_CONTROL(name) \
+static int name##_state(struct snd_kcontrol *kcontrol, \
+		       struct snd_ctl_elem_value *ucontrol) \
+{ \
+	int ret; \
+	mutex_lock(&mt8163_codec_state_mutex); \
+	if (!mInitCodec || !mCodec_data) \
+		ret = -ENODEV; \
+	else \
+		ret = name(kcontrol, ucontrol); \
+	mutex_unlock(&mt8163_codec_state_mutex); \
+	return ret; \
+}
+#define CODEC_CONTROL(name) name##_state
+#endif
