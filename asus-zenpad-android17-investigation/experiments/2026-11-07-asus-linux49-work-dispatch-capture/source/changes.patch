+/* Independent bounded dispatch events. Never held across the work call. */
+#define WD_RING 16
+#define WD_ROW_SIZE 320
+#define WD_ROW_OFFSET 384
+#define WD_SIZE (WD_ROW_OFFSET + WD_RING * WD_ROW_SIZE + 64)
+static char *wd_area, *wd_storage;
