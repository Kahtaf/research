+static const char wd_guard_a[] = "A49WGUARD BEGIN b4702f9a-6b32-423f-b789-d2bd515c0707           \n";
+static const char wd_guard_z[] = "A49WGUARD END   b4702f9a-6b32-423f-b789-d2bd515c0707           \n";
+
+static void wd_fault(unsigned int offset)
+{
+ char *area = READ_ONCE(wd_area);
+ if (!area)
+  return;
+ WRITE_ONCE(area[256 + 9], '1');
+ WRITE_ONCE(area[256 + offset], '1');
+ __clean_dcache_area_poc(area + 256, 64);
+}
+
+static void wd_header(void)
+{
+ char line[192];
+ u64 first = wd_total > WD_RING ? wd_total - WD_RING + 1 : !!wd_total;
+ u64 f[] = {wd_total + 1, wd_total, first, wd_total,
+             wd_total ? (wd_total - 1) / WD_RING : 0,
+             min_t(u64, wd_total, WD_RING), wd_entries, nr_cpu_ids};
+ unsigned int i;
+ memset(line, ' ', sizeof(line));
+ memcpy(line, "!A49WH ", 7);
+ for (i = 0; i < ARRAY_SIZE(f); ++i)
+  cap_hex(line + 9 + i * 17, f[i], 16);
+ cap_hex(line + 160, f[0], 16);
+ line[191] = '\n';
+ sw_commit(wd_storage + 64, line, sizeof(line));
+}
+
+static void __init wd_init(char *dest)
+{
+ unsigned int i, j;
+ char line[WD_ROW_SIZE];
+ BUILD_BUG_ON(WD_SIZE != 5568);
+ memset(dest, ' ', WD_SIZE);
+ memcpy(dest, "A49WD1 uuid=b4702f9a-6b32-423f-b789-d2bd515c0707", 48);
+ dest[63] = '\n';
+ memcpy(dest + 256, "A49WLOSS 0 guard=0 busy=0 admission=0 overflow=0", 48);
+ dest[319] = '\n';
+ memcpy(dest + 320, wd_guard_a, sizeof(wd_guard_a) - 1);
+ dest[383] = '\n';
+ memcpy(dest + WD_SIZE - 64, wd_guard_z, sizeof(wd_guard_z) - 1);
+ dest[WD_SIZE - 1] = '\n';
+ wd_storage = dest;
+ for (i = 0; i < WD_RING; ++i) {
+  memset(line, ' ', sizeof(line));
+  memcpy(line, "!A49W ", 6);
+  cap_hex(line + 6, i, 2);
+  for (j = 0; j < 14; ++j)
+   cap_hex(line + 9 + j * 17, 0, 16);
+  memset(line + 248, '0', 32);
+  cap_hex(line + 288, 0, 16);
+  line[WD_ROW_SIZE - 1] = '\n';
+  sw_commit(dest + WD_ROW_OFFSET + i * WD_ROW_SIZE, line, sizeof(line));
+ }
+ wd_header();
+ __clean_dcache_area_poc(dest, WD_SIZE);
+}
+
+static noinline u64 wd_record(u64 token, unsigned long fn,
+                             unsigned long work, unsigned int kind)
+{
+ char line[WD_ROW_SIZE];
+ u64 f[14], raw, result = 0;
+ unsigned long flags;
+ unsigned int i, row, pc;
+ bool irqoff;
+ if (!smp_load_acquire(&wd_area))
+  return 0; /* Before readiness lies outside the retained horizon. */
+ if (in_nmi()) { wd_fault(36); return 0; }
+ irqoff = irqs_disabled();
+ pc = preempt_count();
+ if (!raw_spin_trylock_irqsave(&wd_lock, flags)) {
+  wd_fault(24); return 0;
+ }
+ /* Read anchors with IRQs masked on the only admitted CPU. Scheduler
+  * acquires neither this lock nor trace_lock; no shared-lock cycle.
+  */
+ if (nr_cpu_ids != 1 || raw_smp_processor_id() ||
+     !irqs_disabled() || !in_task()) {
+  wd_fault(36); goto out;
+ }
+ if (memcmp(wd_storage + 320, wd_guard_a, sizeof(wd_guard_a) - 1) ||
+     memcmp(wd_storage + WD_SIZE - 64, wd_guard_z, sizeof(wd_guard_z) - 1)) {
+  wd_fault(17); goto out;
+ }
+ if (wd_total == U64_MAX - 1 || (kind == 1 && wd_entries == U64_MAX)) {
+  wd_fault(47); goto out;
+ }
+ if (kind == 1)
+  token = ++wd_entries;
+ else if (!token || token > wd_entries) {
+  wd_fault(36); goto out;
+ }
+ /* Single raw register sample; no arch_counter hook or timekeeping. */
+ asm volatile("isb; mrs %0, cntvct_el0" : "=r" (raw));
+ f[0] = ++wd_total;
+ f[1] = token;
+ f[2] = kind;
+ f[3] = raw;
+ f[4] = (u32)current->pid;
+ f[5] = fn;
+ f[6] = work;
+ f[7] = pc;
+ f[8] = irqoff | 2 | 4 | 8; /* before IRQ-off, writer IRQ-off, task, ready */
+ f[9] = READ_ONCE(cap_serial);
+ f[10] = READ_ONCE(sw_total);
+ f[11] = 1;
+ f[12] = !!(READ_ONCE(current->flags) & PF_WQ_WORKER);
+ f[13] = nr_cpu_ids;
+ memset(line, ' ', sizeof(line));
+ memcpy(line, "!A49W ", 6);
+ for (i = 0; i < ARRAY_SIZE(f); ++i)
+  cap_hex(line + 9 + i * 17, f[i], 16);
+ for (i = 0; i < TASK_COMM_LEN; ++i)
+  cap_hex(line + 248 + i * 2, (unsigned char)READ_ONCE(current->comm[i]), 2);
+ cap_hex(line + 288, f[0], 16);
+ line[WD_ROW_SIZE - 1] = '\n';
+ row = (wd_total - 1) % WD_RING;
+ cap_hex(line + 6, row, 2);
