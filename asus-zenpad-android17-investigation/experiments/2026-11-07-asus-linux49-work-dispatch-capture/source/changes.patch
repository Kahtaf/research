+ wd_header();
+ result = token;
+out:
+ raw_spin_unlock_irqrestore(&wd_lock, flags);
+ return result;
+}
+
+noinline u64 asus_capture_work_enter(unsigned long fn, unsigned long work)
+{
+ return wd_record(0, fn, work, 1);
+}
+
+noinline void asus_capture_work_return(u64 token)
+{
+ if (token)
+  wd_record(token, 0, 0, 2); /* Never dereference the possibly freed work. */
+}
