+/* SPDX-License-Identifier: Apache-2.0 */
+#include "transport.h"
+/* Source-derived DAI order is a candidate, not an observed card assignment.
+ * No route can be enabled by a property or HAL parameter. Parent must supply
+ * reviewed on/off sequences and calibration prerequisites in a new revision.
+ * Do not fill these arrays with guessed values to make a test pass. */
+const struct p00a_route p00a_speaker = {
+    .qualified = false, .card = 0, .device = 0, .channels = 2,
+    .card_name = "mt-snd-card",
+};
+const struct p00a_route p00a_microphone = {
+    .qualified = false, .card = 0, .device = 1, .channels = 1,
+    .card_name = "mt-snd-card",
+};
