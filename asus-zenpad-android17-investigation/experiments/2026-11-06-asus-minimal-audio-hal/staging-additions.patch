+++ b/device/asus/p00a/audio/src/transport.c
@@ -0,0 +1,114 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "transport.h"
+#include <errno.h>
+#include <limits.h>
+#include <stdint.h>
+#include <string.h>
+
+static int setting(struct mixer *m, const struct p00a_setting *v, bool apply) {
+    struct mixer_ctl *c = mixer_get_ctl_by_name(m, v->name);
+    if (!c || mixer_ctl_get_type(c) != MIXER_CTL_TYPE_ENUM ||
+        mixer_ctl_get_num_values(c) != 1) return -EINVAL;
+    unsigned n = mixer_ctl_get_num_enums(c);
+    for (unsigned i = 0; i < n; ++i) {
+        const char *name = mixer_ctl_get_enum_string(c, i);
+        if (name && !strcmp(name, v->value))
+            return apply ? (mixer_ctl_set_enum_by_string(c, v->value) == 0 ? 0 : -EIO) : 0;
+    }
+    return -EINVAL;
+}
+
+int p00a_standby(struct p00a_stream *s) {
+    int result = 0;
+    /* Disable analog endpoints before stopping digital clocks. Explicit off
+     * sequence also applies after a partially successful enable sequence. */
+    if (s->mixer) {
+        for (size_t i = 0; i < s->route->off_count; ++i)
+            if (setting(s->mixer, &s->route->off[i], true)) result = -EIO;
+    }
+    if (s->pcm) { pcm_close(s->pcm); s->pcm = NULL; }
+    if (s->mixer) { mixer_close(s->mixer); s->mixer = NULL; }
+    if (result) s->poisoned = true;
+    return result;
+}
+
+int p00a_start(struct p00a_stream *s) {
+    const struct p00a_route *r = s->route;
+    if (s->poisoned) return -EIO;
+    if (s->pcm) return 0;
+    if (!r || !r->qualified || !r->card_name || !r->on || !r->off ||
+        !r->on_count || !r->off_count || r->channels < 1 || r->channels > 2)
+        return -ENODEV;
+    s->mixer = mixer_open(r->card);
+    if (!s->mixer) return -ENODEV;
+    const char *name = mixer_get_name(s->mixer);
+    int error = -EINVAL;
+    if (!name || strcmp(name, r->card_name)) goto invalid;
+    /* Validate the entire enable AND shutdown plan before any mixer write. */
+    for (size_t i = 0; i < r->on_count; ++i)
+        if (setting(s->mixer, &r->on[i], false)) goto invalid;
+    for (size_t i = 0; i < r->off_count; ++i)
+        if (setting(s->mixer, &r->off[i], false)) goto invalid;
+    struct pcm_config config = {
+        .channels = r->channels, .rate = P00A_RATE, .format = PCM_FORMAT_S16_LE,
+        .period_size = P00A_PERIOD, .period_count = P00A_PERIODS,
+        .start_threshold = s->input ? 1 : P00A_PERIOD,
+        .stop_threshold = P00A_PERIOD * P00A_PERIODS,
+        .silence_threshold = 0, .avail_min = P00A_PERIOD,
+    };
+    s->pcm = pcm_open(r->card, r->device, (s->input ? PCM_IN : PCM_OUT) | PCM_NORESTART, &config);
+    if (!s->pcm || !pcm_is_ready(s->pcm)) {
+        error = -ENODEV;
+        if (s->pcm) { pcm_close(s->pcm); s->pcm = NULL; }
+        goto invalid;
+    }
+    /* Codec prepare latches the PCM sample rate before ADC/DAC power-up.
+     * Do not let the first transfer enable analog at the codec's default rate. */
+    if (pcm_prepare(s->pcm) != 0) {
+        pcm_close(s->pcm); s->pcm = NULL; error = -EIO;
+        goto invalid;
+    }
+    for (size_t i = 0; i < r->on_count; ++i) {
+        if (setting(s->mixer, &r->on[i], true)) {
+            p00a_standby(s);
+            return -EIO;
+        }
+    }
+    return 0;
+invalid:
+    mixer_close(s->mixer); s->mixer = NULL;
+    return error;
+}
+
+ssize_t p00a_transfer(struct p00a_stream *s, void *data, size_t bytes) {
+    if (!s->route || s->route->channels < 1 || s->route->channels > 2) return -EINVAL;
+    const size_t frame = s->route->channels * sizeof(int16_t);
+    /* Bound a HAL call to one ring (40 ms), in integral PCM frames. */
+    if (bytes > P00A_PERIOD * P00A_PERIODS * frame || bytes % frame || bytes % 64u ||
+        (bytes && !data)) return -EINVAL;
+    if (!bytes) return 0;
+    int error = p00a_start(s);
+    if (error) return error;
+    size_t done = 0;
+    while (done < bytes) {
+        unsigned frames = (unsigned)((bytes - done) / frame);
+        errno = 0;
+        int n = s->input ? pcm_readi(s->pcm, (char *)data + done, frames)
+                         : pcm_writei(s->pcm, (char *)data + done, frames);
+        if (n <= 0 || (unsigned)n > frames) {
+            /* tinyalsa may return -errno or -1 with errno. No invented progress,
+             * padding, busy retry, or byte/frame confusion on short transfers. */
+            error = n == -1 && errno ? -errno : n < -1 ? n : -EIO;
+            p00a_standby(s);
+            return done ? (ssize_t)done : error;
+        }
+        done += (size_t)n * frame;
+        /* MT8163 copy callbacks round down to 64 bytes. A short result which
+         * leaves an unaligned tail cannot safely be retried through them. */
+        if (done < bytes && (bytes - done) % 64u) {
+            p00a_standby(s);
+            return (ssize_t)done;
+        }
+    }
+    return (ssize_t)done;
+}
