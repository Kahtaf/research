+/* SPDX-License-Identifier: Apache-2.0 */
+#ifndef P00A_TRANSPORT_H
+#define P00A_TRANSPORT_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <sys/types.h>
+#include <tinyalsa/asoundlib.h>
+
+#define P00A_RATE 48000u
+#define P00A_PERIOD 480u
+#define P00A_PERIODS 4u
+struct p00a_setting { const char *name; const char *value; };
+struct p00a_route {
+    bool qualified;
+    unsigned card, device, channels;
+    const char *card_name;
+    const struct p00a_setting *on, *off;
+    size_t on_count, off_count;
+};
+struct p00a_stream {
+    const struct p00a_route *route;
+    struct mixer *mixer;
+    struct pcm *pcm;
+    bool input, poisoned;
+};
+extern const struct p00a_route p00a_speaker, p00a_microphone;
+int p00a_start(struct p00a_stream *s);
+int p00a_standby(struct p00a_stream *s);
+ssize_t p00a_transfer(struct p00a_stream *s, void *data, size_t bytes);
+#endif
