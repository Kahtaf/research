--- /dev/null
+++ b/device/asus/p00a/audio/src/audio_hw.c
@@ -0,0 +1,223 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include <hardware/audio.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "transport.h"
+
+struct device;
+/* Both C stream types start with audio_stream. Keep transport state at the
+ * same offset by embedding their union, rather than casting unequal layouts. */
+struct stream {
+    union { struct audio_stream_out out; struct audio_stream_in in; } api;
+    struct device *dev;
+    struct p00a_stream io;
+};
+struct device {
+    struct audio_hw_device api;
+    pthread_mutex_t lock;
+    struct stream *out, *in;
+    bool mic_muted, fault;
+};
+static struct stream *stream_of(const struct audio_stream *s) { return (struct stream *)s; }
+static audio_channel_mask_t channels(const struct audio_stream *s) {
+    return stream_of(s)->io.input ? AUDIO_CHANNEL_IN_MONO : AUDIO_CHANNEL_OUT_STEREO;
+}
+static uint32_t rate(const struct audio_stream *s) { (void)s; return P00A_RATE; }
+static int set_rate(struct audio_stream *s, uint32_t r) { (void)s; return r == P00A_RATE ? 0 : -EINVAL; }
+static size_t buffer_size(const struct audio_stream *s) { return P00A_PERIOD * (stream_of(s)->io.input ? 2u : 4u); }
+static audio_format_t format(const struct audio_stream *s) { (void)s; return AUDIO_FORMAT_PCM_16_BIT; }
+static int set_format(struct audio_stream *s, audio_format_t f) { (void)s; return f == AUDIO_FORMAT_PCM_16_BIT ? 0 : -EINVAL; }
+static int standby(struct audio_stream *api) {
+    struct stream *s = stream_of(api);
+    pthread_mutex_lock(&s->dev->lock);
+    int r = p00a_standby(&s->io);
+    s->dev->fault |= s->io.poisoned;
+    pthread_mutex_unlock(&s->dev->lock);
+    return r;
+}
+static int stream_dump(const struct audio_stream *api, int fd) {
+    struct stream *s = stream_of(api);
+    pthread_mutex_lock(&s->dev->lock);
+    int r = dprintf(fd, "P00A input=%d qualified=%d active=%d fault=%d\n",
+        s->io.input, s->io.route->qualified, s->io.pcm != NULL, s->dev->fault);
+    pthread_mutex_unlock(&s->dev->lock);
+    return r < 0 ? -errno : 0;
+}
+static audio_devices_t get_device(const struct audio_stream *s) {
+    return stream_of(s)->io.input ? AUDIO_DEVICE_IN_BUILTIN_MIC : AUDIO_DEVICE_OUT_SPEAKER;
+}
+static int set_device(struct audio_stream *s, audio_devices_t d) { return d == get_device(s) ? 0 : -ENOSYS; }
+static int stream_parameters(struct audio_stream *s, const char *kv) {
+    if (!kv) return -EINVAL;
+    if (!*kv) return 0;
+    /* C HAL 2.0 uses routing parameters. Only the single configured endpoint
+     * is accepted; no disconnect/unknown combination is silently discarded. */
+    const char key[] = "routing=";
+    if (!strncmp(kv, key, sizeof(key)-1)) {
+        char *end; errno = 0;
+        unsigned long v = strtoul(kv + sizeof(key)-1, &end, 10);
+        if (end == kv + sizeof(key)-1 || *end || errno || v > UINT32_MAX) return -EINVAL;
+        return set_device(s, (audio_devices_t)v);
+    }
+    return -ENOSYS;
+}
+static char *stream_get_parameters(const struct audio_stream *s, const char *keys) {
+    (void)s; (void)keys; return strdup("");
+}
+static int effect(const struct audio_stream *s, effect_handle_t e) { (void)s; (void)e; return -ENOSYS; }
+static struct audio_stream common_api(void) {
+    return (struct audio_stream){ .get_sample_rate=rate, .set_sample_rate=set_rate,
+        .get_buffer_size=buffer_size, .get_channels=channels, .get_format=format,
+        .set_format=set_format, .standby=standby, .dump=stream_dump,
+        .get_device=get_device, .set_device=set_device, .set_parameters=stream_parameters,
+        .get_parameters=stream_get_parameters, .add_audio_effect=effect, .remove_audio_effect=effect };
+}
+static uint32_t latency(const struct audio_stream_out *s) {
+    (void)s; return P00A_PERIOD * P00A_PERIODS * 1000u / P00A_RATE;
+}
+static int volume(struct audio_stream_out *s, float l, float r) { (void)s; (void)l; (void)r; return -ENOSYS; }
+static int gain(struct audio_stream_in *s, float g) { (void)s; (void)g; return -ENOSYS; }
+static ssize_t transfer(struct stream *s, void *data, size_t n) {
+    pthread_mutex_lock(&s->dev->lock);
+    ssize_t r;
+    if (s->dev->fault) r = -EIO;
+    else if (s->io.input && s->dev->mic_muted) r = -EACCES;
+    else r = p00a_transfer(&s->io, data, n);
+    s->dev->fault |= s->io.poisoned;
+    pthread_mutex_unlock(&s->dev->lock);
+    return r;
+}
+static ssize_t write_pcm(struct audio_stream_out *s, const void *b, size_t n) { return transfer((struct stream *)s, (void *)b, n); }
+static ssize_t read_pcm(struct audio_stream_in *s, void *b, size_t n) { return transfer((struct stream *)s, b, n); }
+static int render_position(const struct audio_stream_out *s, uint32_t *n) { (void)s; (void)n; return -ENOSYS; }
+static int timestamp(const struct audio_stream_out *s, int64_t *n) { (void)s; (void)n; return -ENOSYS; }
+static int presentation(const struct audio_stream_out *s, uint64_t *n, struct timespec *t) { (void)s; (void)n; (void)t; return -ENOSYS; }
+/* API has no error return for lost frames. We have no kernel loss counter;
+ * zero means none counted by this implementation, never a no-overrun claim. */
+static uint32_t lost(struct audio_stream_in *s) { (void)s; return 0; }
+static int check_config(struct audio_config *c, bool input) {
+    if (!c) return -EINVAL;
+    const audio_channel_mask_t mask = input ? AUDIO_CHANNEL_IN_MONO : AUDIO_CHANNEL_OUT_STEREO;
+    bool bad = (c->sample_rate && c->sample_rate != P00A_RATE) ||
+        (c->format != AUDIO_FORMAT_DEFAULT && c->format != AUDIO_FORMAT_PCM_16_BIT) ||
+        (c->channel_mask != AUDIO_CHANNEL_NONE && c->channel_mask != mask);
+    c->sample_rate=P00A_RATE; c->format=AUDIO_FORMAT_PCM_16_BIT; c->channel_mask=mask;
+    return bad ? -EINVAL : 0;
+}
+static int open_stream(struct device *d, struct audio_config *c, bool input, struct stream **result) {
+    *result=NULL;
+    int r=check_config(c,input);
+    if (r) return r;
+    const struct p00a_route *route = input ? &p00a_microphone : &p00a_speaker;
+    if (!route->qualified) return -ENODEV;
+    pthread_mutex_lock(&d->lock);
+    struct stream **slot=input ? &d->in : &d->out;
+    if (d->fault) r=-EIO;
+    else if (*slot || d->in || d->out) r=-EBUSY; /* duplex is not qualified */
+    else {
+        struct stream *s=calloc(1,sizeof(*s));
+        if (!s) r=-ENOMEM;
+        else {
+            s->dev=d; s->io.input=input; s->io.route=route;
+            if (input) s->api.in=(struct audio_stream_in){.common=common_api(),.set_gain=gain,.read=read_pcm,.get_input_frames_lost=lost};
+            else s->api.out=(struct audio_stream_out){.common=common_api(),.get_latency=latency,.set_volume=volume,
+                .write=write_pcm,.get_render_position=render_position,.get_next_write_timestamp=timestamp,.get_presentation_position=presentation};
+            *slot=s; *result=s;
+        }
+    }
+    pthread_mutex_unlock(&d->lock);
+    return r;
+}
+static int open_out(struct audio_hw_device *api, audio_io_handle_t h, audio_devices_t devices,
+    audio_output_flags_t flags, struct audio_config *c, struct audio_stream_out **out, const char *address) {
+    (void)h;
+    if (!out) return -EINVAL;
+    *out=NULL;
+    if (devices != AUDIO_DEVICE_OUT_SPEAKER || (flags & ~AUDIO_OUTPUT_FLAG_PRIMARY) || (address && *address)) return -EINVAL;
+    struct stream *s;
+    int r=open_stream((struct device *)api,c,false,&s);
+    if (!r) *out=&s->api.out;
+    return r;
+}
+static int open_in(struct audio_hw_device *api, audio_io_handle_t h, audio_devices_t devices,
+    struct audio_config *c, struct audio_stream_in **in, audio_input_flags_t flags, const char *address, audio_source_t source) {
+    (void)h;
+    if (!in) return -EINVAL;
+    *in=NULL;
+    if (devices != AUDIO_DEVICE_IN_BUILTIN_MIC || flags != AUDIO_INPUT_FLAG_NONE || (address && *address) ||
+        (source != AUDIO_SOURCE_DEFAULT && source != AUDIO_SOURCE_MIC)) return -EINVAL;
+    struct stream *s;
+    int r=open_stream((struct device *)api,c,true,&s);
+    if (!r) *in=&s->api.in;
+    return r;
+}
+static void close_stream(struct device *d, struct stream *s) {
+    if (!s) return;
+    pthread_mutex_lock(&d->lock);
+    p00a_standby(&s->io); d->fault |= s->io.poisoned;
+    if (s->io.input) d->in=NULL; else d->out=NULL;
+    free(s);
+    pthread_mutex_unlock(&d->lock);
+}
+static void close_out(struct audio_hw_device *d, struct audio_stream_out *s) { close_stream((struct device *)d,(struct stream *)s); }
+static void close_in(struct audio_hw_device *d, struct audio_stream_in *s) { close_stream((struct device *)d,(struct stream *)s); }
+static int init_check(const struct audio_hw_device *d) {
+    (void)d; return p00a_speaker.qualified && p00a_microphone.qualified ? 0 : -ENODEV;
+}
+static int device_volume(struct audio_hw_device *d, float v) { (void)d; (void)v; return -ENOSYS; }
+static int mode(struct audio_hw_device *d, audio_mode_t m) { (void)d; return m == AUDIO_MODE_NORMAL ? 0 : -ENOSYS; }
+static int mute(struct audio_hw_device *api, bool value) {
+    struct device *d=(struct device *)api;
+    pthread_mutex_lock(&d->lock);
+    d->mic_muted=value;
+    int r=0;
+    if (value && d->in) { r=p00a_standby(&d->in->io); d->fault |= d->in->io.poisoned; }
+    pthread_mutex_unlock(&d->lock);
+    return r;
+}
+static int get_mute(const struct audio_hw_device *api, bool *value) {
+    if (!value) return -EINVAL;
+    struct device *d=(struct device *)api;
+    pthread_mutex_lock(&d->lock); *value=d->mic_muted; pthread_mutex_unlock(&d->lock); return 0;
+}
+static int device_parameters(struct audio_hw_device *d, const char *kv) { (void)d; return !kv ? -EINVAL : *kv ? -ENOSYS : 0; }
+static char *device_get_parameters(const struct audio_hw_device *d, const char *keys) { (void)d; (void)keys; return strdup(""); }
+static size_t input_size(const struct audio_hw_device *d, const struct audio_config *c) {
+    (void)d; if (!c) return 0; struct audio_config copy=*c;
+    return check_config(&copy,true) ? 0 : P00A_PERIOD*2u;
+}
+static int device_dump(const struct audio_hw_device *d, int fd) {
+    (void)d; return dprintf(fd,"P00A source HAL API2.0: speaker/mic activation gated; no hardware qualification\n") < 0 ? -errno : 0;
+}
+static int close_device(struct hw_device_t *api) {
+    struct device *d=(struct device *)api;
+    pthread_mutex_lock(&d->lock);
+    if (d->in || d->out) { pthread_mutex_unlock(&d->lock); return -EBUSY; }
+    pthread_mutex_unlock(&d->lock); pthread_mutex_destroy(&d->lock); free(d); return 0;
+}
+static int module_open(const struct hw_module_t *module, const char *name, struct hw_device_t **out) {
+    if (!out) return -EINVAL;
+    *out=NULL;
+    if (!name || strcmp(name,AUDIO_HARDWARE_INTERFACE)) return -EINVAL;
+    struct device *d=calloc(1,sizeof(*d));
+    if (!d) return -ENOMEM;
+    int r=pthread_mutex_init(&d->lock,NULL);
+    if (r) { free(d); return -r; }
+    d->api=(struct audio_hw_device){
+        .common={.tag=HARDWARE_DEVICE_TAG,.version=AUDIO_DEVICE_API_VERSION_2_0,.module=(struct hw_module_t *)module,.close=close_device},
+        .init_check=init_check,.set_voice_volume=device_volume,.set_master_volume=device_volume,
+        .set_mode=mode,.set_mic_mute=mute,.get_mic_mute=get_mute,.set_parameters=device_parameters,
+        .get_parameters=device_get_parameters,.get_input_buffer_size=input_size,
+        .open_output_stream=open_out,.close_output_stream=close_out,.open_input_stream=open_in,
+        .close_input_stream=close_in,.dump=device_dump};
+    *out=&d->api.common; return 0;
+}
+static struct hw_module_methods_t methods={.open=module_open};
+__attribute__((visibility("default"))) struct audio_module HAL_MODULE_INFO_SYM={.common={
+    .tag=HARDWARE_MODULE_TAG,.module_api_version=AUDIO_MODULE_API_VERSION_0_1,
+    .hal_api_version=HARDWARE_HAL_API_VERSION,.id=AUDIO_HARDWARE_MODULE_ID,
+    .name="P00A bounded PCM primary (routes gated)",.author="P00A bring-up",.methods=&methods}};
