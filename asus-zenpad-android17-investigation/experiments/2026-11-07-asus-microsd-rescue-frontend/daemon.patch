@@ -0,0 +1,55 @@
+#ifndef RESCUE_SD_MOUNT_H
+#define RESCUE_SD_MOUNT_H
+/* Fixed source only. Sysfs symlinks are kernel-owned; user/card paths never are. */
+static int sd_number(const char *name,uint64_t *v){
+ char t[64],*end;if(read_text(name,t,sizeof(t))<1||t[0]<'0'||t[0]>'9')return 0;
+ errno=0;*v=strtoull(t,&end,10);return !errno&&!*end;
+}
+static int sd_identified(void){
+ char t[64],p[512],a[4096],b[4096],part[4096],internal[4096];uint64_t start,size,disk;
+ if(read_text("/sys/class/block/mmcblk1/removable",t,sizeof(t))!=1||strcmp(t,"1")||
+    read_text("/sys/class/block/mmcblk1/device/type",t,sizeof(t))!=2||strcmp(t,"SD")||
+    read_text("/sys/class/block/mmcblk1/dev",t,sizeof(t))!=6||strcmp(t,"179:32")||
+    read_text("/sys/class/block/mmcblk1p1/dev",t,sizeof(t))!=6||strcmp(t,"179:33")||
+    read_text("/sys/class/block/mmcblk1p1/partition",t,sizeof(t))!=1||strcmp(t,"1"))return 0;
+ path(p,sizeof(p),"/sys/class/block/mmcblk1");if(!realpath(p,a))return 0;
+ path(p,sizeof(p),"/sys/dev/block/179:32");if(!realpath(p,b)||strcmp(a,b))return 0;
+ path(p,sizeof(p),"/sys/class/block/mmcblk0");if(!realpath(p,internal)||!strcmp(a,internal))return 0;
+ path(p,sizeof(p),"/sys/class/block/mmcblk1p1");if(!realpath(p,part))return 0;
+ path(p,sizeof(p),"/sys/dev/block/179:33");if(!realpath(p,b)||strcmp(part,b))return 0;
+ char *slash=strrchr(part,'/');if(!slash||strcmp(slash+1,"mmcblk1p1"))return 0;*slash=0;
+ if(strcmp(part,a))return 0;
+ path(p,sizeof(p),"/sys/class/block/mmcblk1/device");if(!realpath(p,a))return 0;
+ path(p,sizeof(p),"/sys/class/block/mmcblk0/device");if(!realpath(p,b)||!strcmp(a,b))return 0;
+ return sd_number("/sys/class/block/mmcblk1p1/start",&start)&&start>0&&
+        sd_number("/sys/class/block/mmcblk1p1/size",&size)&&size>0&&
+        sd_number("/sys/class/block/mmcblk1/size",&disk)&&start<disk&&size<=disk-start;
+}
+static int sd_option(const char *list,const char *option){
+ size_t n=strlen(option);for(const char *p=list;*p;){const char *e=strchr(p,',');if(!e)e=p+strlen(p);
+ if((size_t)(e-p)==n&&!memcmp(p,option,n))return 1;p=*e?e+1:e;}return 0;
+}
+static int sd_mount_line(const char *line,unsigned maj,unsigned minor){
+ if(maj!=179||minor!=33||!sd_identified())return 0;
+ char copy[8192],*v[128],*save;size_t count=0;
+ if(strlen(line)>=sizeof(copy))return 0;strcpy(copy,line);
+ for(char *p=strtok_r(copy," \n",&save);p;p=strtok_r(NULL," \n",&save)){
+  if(count==128)return 0;v[count++]=p;
+ }
+ if(count<10||strcmp(v[3],"/")||strcmp(v[4],"/mnt/rescue-sd"))return 0;
+ size_t sep=6;while(sep<count&&strcmp(v[sep],"-"))sep++;
+ if(sep+4!=count||strcmp(v[sep+1],"vfat")||strcmp(v[sep+2],"/dev/block/mmcblk1p1"))return 0;
+ return sd_option(v[5],"rw")&&sd_option(v[5],"nodev")&&sd_option(v[5],"nosuid")&&sd_option(v[5],"noexec")&&sd_option(v[sep+3],"rw");
+}
+static int sd_mounts_safe(int require_sd){
+ char p[512],line[8192];path(p,sizeof(p),"/proc/self/mountinfo");FILE *f=fopen(p,"re");if(!f)return 0;
+ int ok=1,seen=0;while(fgets(line,sizeof(line),f)){
+  unsigned a,b,maj,minor;if(!strchr(line,'\n')||sscanf(line,"%u %u %u:%u",&a,&b,&maj,&minor)!=4){ok=0;break;}
+  /* A shadow mount at the fixed mountpoint is never an alternate source. */
+  char root[512],mount[512];if(sscanf(line,"%*u %*u %*u:%*u %511s %511s",root,mount)!=2){ok=0;break;}
+  if(maj==179){if(!sd_mount_line(line,maj,minor)||++seen>1){ok=0;break;}}
+  else if(!strcmp(mount,"/mnt/rescue-sd")){ok=0;break;}
+ }
+ if(ferror(f))ok=0;fclose(f);return ok&&(!require_sd||seen==1);
+}
+#endif
