+ token = (++cap_serial << 8) | (kind << 4) | slot;
+ s->active = token;
+ s->f[C_ENTER] = token;
+ ++s->f[C_ENTRIES];
+ s->f[C_PARENT] = parent;
+ s->f[C_SEQ_ENTER] = seq;
+ s->f[C_SEQ_LAST] = seq;
