+
+void asus_capture_exit(u64 token, u64 value, u32 seq)
+{
+ unsigned long flags;
+ unsigned int row;
+ struct cap_state *s;
+ if (!token || !cap_lock(&flags))
+  return;
+ s = cap_match(token, &row);
+ if (s) {
