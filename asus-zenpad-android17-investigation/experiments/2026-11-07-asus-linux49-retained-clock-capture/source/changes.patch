+u64 asus_capture_mono_enter(u32 seq, unsigned long caller)
+{
+ unsigned long flags;
+ u64 token;
+ if (in_interrupt() || current->pid != 1 || !cap_lock(&flags))
+  return 0;
+ token = cap_enter(0, CAP_MONO, 0, seq, caller, 0, 0);
+ raw_spin_unlock_irqrestore(&trace_lock, flags);
+ return token;
