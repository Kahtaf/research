+
+void asus_capture_mono_seq(u64 token, u32 seq, unsigned int stage)
+{
+ unsigned long flags;
+ unsigned int row;
+ struct cap_state *s;
+ if (!token || !cap_lock(&flags))
+  return;
+ s = cap_match(token, &row);
+ if (s) { s->f[C_SEQ_LAST] = seq; s->f[C_STAGE] = stage; cap_publish(row); }
+ raw_spin_unlock_irqrestore(&trace_lock, flags);
