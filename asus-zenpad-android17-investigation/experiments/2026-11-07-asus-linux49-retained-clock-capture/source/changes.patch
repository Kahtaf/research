+
+static struct cap_state *cap_match(u64 token, unsigned int *row)
+{
+ unsigned int slot = token & 15, kind = (token >> 4) & 15;
+ if (slot >= 5 || kind >= 3) { cap_fault(); return NULL; }
+ *row = slot * 3 + kind;
+ if (cap_rows[*row].active != token) { cap_fault(); return NULL; }
+ return &cap_rows[*row];
+}
