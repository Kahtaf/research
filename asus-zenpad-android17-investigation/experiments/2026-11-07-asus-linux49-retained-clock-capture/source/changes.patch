+  ++s->f[C_COMPLETE];
+  s->f[C_RAW] = value;
+  s->f[C_SEQ_LAST] = seq;
+  s->f[C_STAGE] = 4;
+  s->f[C_CPU_EXIT] = raw_smp_processor_id();
+  s->active = 0;
+  cap_publish(row);
