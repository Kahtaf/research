+++ b/sound/soc/mediatek/mt_soc_audio_8163/p00a_stock_gate.h
@@ -0,0 +1,195 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Unqualified P00A stock software contract; not fitted-amplifier evidence. */
+#ifndef P00A_STOCK_GATE_H
+#define P00A_STOCK_GATE_H
+
+#include <linux/device.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/gpio.h>
+#include <linux/of_gpio.h>
+
+#if !defined(CONFIG_OF) || !defined(CONFIG_OF_GPIO) || \
+	!defined(CONFIG_GPIOLIB) || !defined(CONFIG_PINCTRL_MT8163) || \
+	!defined(CONFIG_MTK_SPEAKER) || \
+	defined(CONFIG_AMP_AW8737S) || defined(CONFIG_MTK_LEGACY)
+#error "P00A stock gate requires OF/internal speaker and excludes legacy/AW"
+#endif
+
+static DEFINE_MUTEX(p00a_gate_lock);
+static struct device *p00a_gate_owner;
+static int p00a_gate_gpio = -EINVAL;
+static bool p00a_gate_on, p00a_gate_fault, p00a_gate_stopping;
+static bool p00a_gate_suspended;
+
+static void p00a_gate_cache(bool on)
+{
+	lockdep_assert_held(&mt8163_codec_state_mutex);
+	p00a_gate_on = on;
+	if (mCodec_data)
+		mCodec_data->mAudio_Ana_DevicePower[
+			AUDIO_ANALOG_DEVICE_OUT_EXTSPKAMP] = on;
+}
+
+/* Caller holds p00a_gate_lock. Direction API reports errors; setters are void. */
+static int p00a_gate_output_locked(bool on)
+{
+	int ret, off_ret;
+
+	lockdep_assert_held(&mt8163_codec_state_mutex);
+	if (!p00a_gate_owner)
+		return -ENODEV;
+	if (on && p00a_gate_stopping)
+		return -ESHUTDOWN;
+	if (on && p00a_gate_fault)
+		return -EIO;
+	if (on && p00a_gate_suspended)
+		return -EBUSY;
+	if (!p00a_gate_fault && p00a_gate_on == on)
+		return 0;
+
+	ret = gpio_direction_output(p00a_gate_gpio, on);
+	if (ret) {
+		p00a_gate_fault = true;
+		/* An error may follow a partial hardware write. Never claim On. */
+		off_ret = gpio_direction_output(p00a_gate_gpio, 0);
+		if (!off_ret)
+			p00a_gate_cache(false);
+		dev_err(p00a_gate_owner,
+			"stock gate operation failed %d; off retry %d; state faulted\n",
+			ret, off_ret);
+		return ret;
+	}
+	p00a_gate_cache(on);
+	return 1;
+}
+
+static int p00a_gate_set(bool on)
+{
+	int ret;
+
+	lockdep_assert_held(&mt8163_codec_state_mutex);
+	mutex_lock(&p00a_gate_lock);
+	ret = mCodec_data && mInitCodec ?
+		p00a_gate_output_locked(on) : -ENODEV;
+	mutex_unlock(&p00a_gate_lock);
+	return ret;
+}
+
+static int p00a_gate_get(void)
+{
+	int ret;
+
+	lockdep_assert_held(&mt8163_codec_state_mutex);
+	mutex_lock(&p00a_gate_lock);
+	ret = !p00a_gate_owner || !mCodec_data || !mInitCodec ? -ENODEV :
+		(p00a_gate_fault ? -EIO : p00a_gate_on);
+	mutex_unlock(&p00a_gate_lock);
+	return ret;
+}
+
+static int p00a_gate_suspend(bool suspend)
+{
+	int ret = 0;
+
+	lockdep_assert_held(&mt8163_codec_state_mutex);
+	mutex_lock(&p00a_gate_lock);
+	p00a_gate_suspended = suspend;
+	if (suspend)
+		ret = p00a_gate_output_locked(false);
+	mutex_unlock(&p00a_gate_lock);
+	return ret;
+}
+
+static int p00a_gate_stop(struct device *dev)
+{
+	int ret = 0;
+
+	lockdep_assert_held(&mt8163_codec_state_mutex);
+	mutex_lock(&p00a_gate_lock);
+	if (p00a_gate_owner == dev) {
+		p00a_gate_stopping = true;
+		ret = p00a_gate_output_locked(false);
+	}
+	mutex_unlock(&p00a_gate_lock);
+	return ret;
+}
+
+/* Added after the managed request: executes before the GPIO is released. */
+static void p00a_gate_release(void *data)
+{
+	struct device *dev = data;
+
+	mutex_lock(&mt8163_codec_state_mutex);
+	p00a_gate_stop(dev);
+	mutex_lock(&p00a_gate_lock);
+	if (p00a_gate_owner == dev) {
+		p00a_gate_owner = NULL;
+		p00a_gate_gpio = -EINVAL;
+	}
+	mutex_unlock(&p00a_gate_lock);
+	mutex_unlock(&mt8163_codec_state_mutex);
+}
+
+static int p00a_gate_probe(struct device *dev)
+{
+	struct device_node *np = dev->of_node;
+	struct of_phandle_args spec;
+	enum of_gpio_flags flags = 0;
+	int ret, gpio;
+	bool valid;
+
+	if (!np || !of_machine_is_compatible("asus,p00a") ||
+	    !of_device_is_compatible(np, "mediatek,mt8163-soc-codec-63xx") ||
+	    !of_property_read_bool(np, "asus,p00a-stock-speaker-gate"))
+		return -ENODEV;
+	/* Keep the exact public stock singular binding, with no suffix fallback. */
+	if (of_find_property(np, "extspkamp-gpios", NULL))
+		return -EINVAL;
+	if (!of_find_property(np, "extspkamp-gpio", NULL))
+		return -ENOENT;
+	if (of_property_count_u32_elems(np, "extspkamp-gpio") != 3)
+		return -EINVAL;
+	ret = of_parse_phandle_with_args(np, "extspkamp-gpio", "#gpio-cells",
+					 0, &spec);
+	if (ret)
+		return ret;
+	valid = spec.args_count == 2 && spec.args[0] == 28 &&
+		spec.args[1] == 0 &&
+		of_device_is_compatible(spec.np, "mediatek,mt8163-pinctrl") &&
+		of_property_read_bool(spec.np, "gpio-controller");
+	of_node_put(spec.np);
+	if (!valid)
+		return -EINVAL;
+
+	gpio = of_get_named_gpio_flags(np, "extspkamp-gpio", 0, &flags);
+	if (gpio < 0)
+		return gpio;
+	if (!gpio_is_valid(gpio) || flags != 0)
+		return -EINVAL;
+
+	mutex_lock(&mt8163_codec_state_mutex);
+	mutex_lock(&p00a_gate_lock);
+	if (p00a_gate_owner) {
+		mutex_unlock(&p00a_gate_lock);
+		mutex_unlock(&mt8163_codec_state_mutex);
+		return -EBUSY;
+	}
+	ret = devm_gpio_request_one(dev, gpio, GPIOF_OUT_INIT_LOW,
+				    "spkamp-en-gpio");
+	if (ret) {
+		mutex_unlock(&p00a_gate_lock);
+		mutex_unlock(&mt8163_codec_state_mutex);
+		return ret;
+	}
+	p00a_gate_gpio = gpio;
+	p00a_gate_owner = dev;
+	p00a_gate_on = false;
+	p00a_gate_fault = false;
+	p00a_gate_stopping = false;
+	p00a_gate_suspended = mAnaSuspend;
+	mutex_unlock(&p00a_gate_lock);
+	mutex_unlock(&mt8163_codec_state_mutex);
+	return devm_add_action_or_reset(dev, p00a_gate_release, dev);
+}
+#endif
