--- /dev/null
+++ b/source/recovery_phase.h
@@ -0,0 +1,47 @@
+/* Valid only in the reviewed fixed RAM service graph: ordinary RSC cannot
+ * write p10; its only recovery writer replaces this process by exec, holding
+ * the lifetime writer lock. Metadata is NOT a content-change detector.
+ * Every connection owns its own FD/proofs; no guard survives session exit. */
+struct recovery_phase {
+ int fd, image, writing;
+ struct stat node;
+ unsigned char manifest[32], pin[32], token[32];
+};
+static void recovery_phase_close(struct recovery_phase *g){
+ if(g->fd>=0)close(g->fd);
+ memset(g,0,sizeof(*g));g->fd=-1;
+}
+static int recovery_phase_node(struct recovery_phase *g){
+ struct stat s;
+ if(g->fd<0||memcmp(g->manifest,manifest_id,32)||memcmp(g->pin,recovery_pin,32)||
+    fstat(g->fd,&s)||s.st_dev!=g->node.st_dev||s.st_ino!=g->node.st_ino||
+    s.st_rdev!=g->node.st_rdev||s.st_mode!=g->node.st_mode||
+    s.st_uid!=g->node.st_uid||s.st_gid!=g->node.st_gid||
+    validate_fd(g->fd,geom(10))){recovery_phase_close(g);return -1;}
+ return 0;
+}
+static int recovery_phase_full(struct recovery_phase *g){
+ unsigned char h[32];
+ if(recovery_phase_node(g)||fd_hash(g->fd,geom(10)->size,h)||
+    memcmp(h,g->pin,32)||recovery_phase_node(g)){
+  recovery_phase_close(g);return -1;
+ }
+ return 0;
+}
+static int recovery_phase_open(struct recovery_phase *g){
+ recovery_phase_close(g);
+ g->fd=open_part(10,0);
+ if(g->fd<0||fstat(g->fd,&g->node)){recovery_phase_close(g);return -1;}
+ memcpy(g->manifest,manifest_id,32);memcpy(g->pin,recovery_pin,32);
+ return recovery_phase_full(g);
+}
+static int recovery_phase_activate(struct recovery_phase *g,int image,const unsigned char *token){
+ if(recovery_phase_full(g))return -1;
+ g->image=image;memcpy(g->token,token,32);g->writing=1;return 0;
+}
+static int recovery_phase_chunk(struct recovery_phase *g,int image,const unsigned char *token){
+ if(!g->writing||g->image!=image||memcmp(g->token,token,32)){
+  recovery_phase_close(g);return -1;
+ }
+ return recovery_phase_node(g);
+}
