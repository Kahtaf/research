--- /dev/null
+++ b/drivers/misc/mediatek/power/mt8163/asus_p00a/bq25896.c
@@ -0,0 +1,233 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Pad-only ASUS P00A integration. Register/policy provenance: PROVENANCE.md. */
+#include <linux/delay.h>
+#include <linux/gpio.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of_gpio.h>
+#include <linux/reboot.h>
+#include <linux/regmap.h>
+#include <linux/workqueue.h>
+#include <mt-plat/battery_common.h>
+#include <mt-plat/battery_meter.h>
+#include <mt-plat/mtk_boot.h>
+#include <mt-plat/upmu_common.h>
+#include "policy.h"
+
+#define REG_INPUT 0x00
+#define REG_ADC 0x02
+#define REG_CONTROL 0x03
+#define REG_ICHG 0x04
+#define REG_TERM 0x05
+#define REG_CV 0x06
+#define REG_TIMER 0x07
+#define REG_STATUS 0x0b
+#define REG_FAULT 0x0c
+#define REG_TS 0x10
+#define REG_ID 0x14
+#define CHG_ENABLE BIT(4)
+#define OTG_ENABLE BIT(5)
+
+struct p00a_power {
+	struct device *dev;
+	struct regmap *map;
+	struct mutex lock;
+	struct delayed_work monitor;
+	struct p00a_limits limits;
+	unsigned int error_state;
+	int programmed_cv;
+	bool initialized;
+	bool needs_programming;
+};
+
+bool chargin_hw_init_done;
+static DEFINE_MUTEX(p00a_global_lock);
+static struct p00a_power *p00a;
+
+static const struct regmap_config p00a_regmap = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = REG_ID,
+	.cache_type = REGCACHE_NONE,
+};
+
+#include "control.h"
+
+int chr_control_interface(int cmd, void *data)
+{
+	int ret;
+
+	mutex_lock(&p00a_global_lock);
+	if (!p00a) {
+		mutex_unlock(&p00a_global_lock);
+		return -ENODEV;
+	}
+	mutex_lock(&p00a->lock);
+	ret = p00a_command(p00a, cmd, data);
+	mutex_unlock(&p00a->lock);
+	mutex_unlock(&p00a_global_lock);
+	return ret;
+}
+
+static void p00a_monitor(struct work_struct *work)
+{
+	struct p00a_power *p = container_of(to_delayed_work(work),
+		struct p00a_power, monitor);
+	int ret;
+
+	mutex_lock(&p->lock);
+	ret = p00a_apply(p);
+	if (ret && ret != -EAGAIN)
+		dev_warn_ratelimited(p->dev, "charging guard: %d\n", ret);
+	if (!p->limits.suspended)
+		schedule_delayed_work(&p->monitor, 5 * HZ);
+	mutex_unlock(&p->lock);
+}
+
+static int p00a_gpio(struct device *dev, const char *property, int level)
+{
+	int gpio = of_get_named_gpio(dev->of_node, property, 0);
+
+	if (gpio < 0)
+		return gpio;
+	return devm_gpio_request_one(dev, gpio,
+		level ? GPIOF_OUT_INIT_HIGH : GPIOF_OUT_INIT_LOW, property);
+}
+
+static int p00a_probe(struct i2c_client *client, const struct i2c_device_id *id)
+{
+	static const struct { const char *name; int level; } routing[] = {
+		{ "pg_otg_en_soc_gpio", 0 },
+		{ "usb_bus_on_num_gpio", 0 },
+		{ "cover_bus_on_gpio", 0 },
+		{ "cover_bus_off_gpio", 1 },
+	};
+	struct p00a_power *p;
+	unsigned int value;
+	int i, ret;
+
+	if (!of_machine_is_compatible("asus,p00a"))
+		return -ENODEV;
+	p = devm_kzalloc(&client->dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	p->dev = &client->dev;
+	mutex_init(&p->lock);
+	INIT_DELAYED_WORK(&p->monitor, p00a_monitor);
+	p->limits.input_cap_ma = 100;
+	p->limits.charging_permitted = of_property_read_bool(client->dev.of_node,
+		"asus,allow-battery-charging");
+	p->map = devm_regmap_init_i2c(client, &p00a_regmap);
+	if (IS_ERR(p->map))
+		return PTR_ERR(p->map);
+	ret = regmap_read(p->map, REG_ID, &value);
+	if (ret)
+		return ret;
+	if (((value >> 3) & 7) != 0 || !(value & BIT(2)))
+		return -ENODEV;
+	ret = p00a_disable(p);
+	if (ret)
+		return ret;
+	for (i = 0; i < ARRAY_SIZE(routing); i++) {
+		ret = p00a_gpio(p->dev, routing[i].name, routing[i].level);
+		if (ret)
+			return ret;
+	}
+	ret = p00a_hw_init(p);
+	if (ret)
+		return ret;
+	i2c_set_clientdata(client, p);
+	mutex_lock(&p00a_global_lock);
+	if (p00a) {
+		mutex_unlock(&p00a_global_lock);
+		return -EBUSY;
+	}
+	p00a = p;
+	WRITE_ONCE(chargin_hw_init_done, true);
+	mutex_unlock(&p00a_global_lock);
+	schedule_delayed_work(&p->monitor, HZ);
+	dev_info(p->dev, "ASUS pad charger ready; charging %s pending validation\n",
+		p->limits.charging_permitted ? "permitted" : "inhibited");
+	return 0;
+}
+
+static int p00a_remove(struct i2c_client *client)
+{
+	struct p00a_power *p = i2c_get_clientdata(client);
+
+	mutex_lock(&p00a_global_lock);
+	WRITE_ONCE(chargin_hw_init_done, false);
+	p00a = NULL;
+	mutex_unlock(&p00a_global_lock);
+	mutex_lock(&p->lock);
+	p->limits.suspended = true;
+	mutex_unlock(&p->lock);
+	cancel_delayed_work_sync(&p->monitor);
+	return p00a_disable(p);
+}
+
+static void p00a_shutdown(struct i2c_client *client)
+{
+	struct p00a_power *p = i2c_get_clientdata(client);
+
+	mutex_lock(&p->lock);
+	p->limits.suspended = true;
+	p00a_disable(p);
+	mutex_unlock(&p->lock);
+	cancel_delayed_work_sync(&p->monitor);
+}
+
+static int p00a_suspend(struct device *dev)
+{
+	struct p00a_power *p = dev_get_drvdata(dev);
+	int ret;
+
+	mutex_lock(&p->lock);
+	p->limits.suspended = true;
+	ret = p00a_disable(p);
+	mutex_unlock(&p->lock);
+	cancel_delayed_work_sync(&p->monitor);
+	if (ret) {
+		mutex_lock(&p->lock);
+		p->limits.suspended = false;
+		mutex_unlock(&p->lock);
+		schedule_delayed_work(&p->monitor, 0);
+	}
+	return ret;
+}
+
+static int p00a_resume(struct device *dev)
+{
+	struct p00a_power *p = dev_get_drvdata(dev);
+
+	mutex_lock(&p->lock);
+	p->limits.suspended = false;
+	mutex_unlock(&p->lock);
+	schedule_delayed_work(&p->monitor, 0);
+	return 0;
+}
+
+static const struct dev_pm_ops p00a_pm = {
+	SET_SYSTEM_SLEEP_PM_OPS(p00a_suspend, p00a_resume)
+};
+static const struct of_device_id p00a_match[] = {
+	{ .compatible = "ti,bq25896" }, {}
+};
+MODULE_DEVICE_TABLE(of, p00a_match);
+static const struct i2c_device_id p00a_ids[] = { { "bq25896", 0 }, {} };
+MODULE_DEVICE_TABLE(i2c, p00a_ids);
+static struct i2c_driver p00a_driver = {
+	.driver = {
+		.name = "asus-p00a-bq25896",
+		.of_match_table = p00a_match,
+		.pm = &p00a_pm,
+	},
+	.probe = p00a_probe,
+	.remove = p00a_remove,
+	.shutdown = p00a_shutdown,
+	.id_table = p00a_ids,
+};
+module_i2c_driver(p00a_driver);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("ASUS P00A BQ25896 pad charging integration");
