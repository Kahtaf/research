+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef ASUS_P00A_POWER_CONTROL_H
+#define ASUS_P00A_POWER_CONTROL_H
+
+static int p00a_disable(struct p00a_power *p)
+{
+	return regmap_update_bits(p->map, REG_CONTROL, CHG_ENABLE, 0);
+}
+
+static int p00a_sample(struct p00a_power *p)
+{
+	unsigned int previous, fault_now, ts, status;
+	int ret;
+
+	p->limits.sensors_valid = false;
+	ret = regmap_read(p->map, REG_STATUS, &status);
+	if (ret)
+		return ret;
+	p->limits.charger_present = !!(status & BIT(2));
+	if (!p->limits.charger_present) {
+		p->limits.input_cap_ma = 100;
+		p->limits.enable_requested = false;
+		p->needs_programming = true;
+	}
+	ret = regmap_read(p->map, REG_FAULT, &previous);
+	if (ret)
+		return ret;
+	ret = regmap_read(p->map, REG_FAULT, &fault_now);
+	if (ret)
+		return ret;
+	ret = regmap_read(p->map, REG_TS, &ts);
+	if (ret)
+		return ret;
+	p->limits.fault = previous | fault_now;
+	p->limits.ts_raw = ts & 0x7f;
+	p->limits.temp_c = READ_ONCE(BMT_status.temperature);
+	p->limits.battery_present = READ_ONCE(BMT_status.bat_exist);
+	p->limits.sensors_valid = p->limits.temp_c >= -20 &&
+		p->limits.temp_c <= 80 &&
+		READ_ONCE(BMT_status.bat_vol) >= 2500 &&
+		READ_ONCE(BMT_status.bat_vol) <= 4500 &&
+		p->limits.ts_raw > 0 && p->limits.ts_raw < 127;
+	return 0;
+}
+
+static int p00a_apply(struct p00a_power *p)
+{
+	int cv, input, ret, stop_ret;
+
+	if (!p->initialized)
+		return -EAGAIN;
+	ret = p00a_sample(p);
+	if (ret)
+		goto stop;
+	if (!p00a_can_charge(&p->limits)) {
+		ret = p->limits.enable_requested ? -EAGAIN : 0;
+		goto stop;
+	}
+	cv = p00a_effective_cv(&p->limits);
+	input = p00a_input_code(p->limits.input_10ua, p->limits.input_cap_ma);
+	if (p->programmed_cv != cv)
+		p->needs_programming = true;
+	if (p->needs_programming) {
+		ret = p00a_disable(p);
+		if (ret)
+			return ret;
+		ret = regmap_update_bits(p->map, REG_CV, 0xfc, cv << 2);
+		if (ret)
+			goto stop;
+		ret = regmap_update_bits(p->map, REG_ICHG, 0x7f,
+			p00a_ichg_code(p->limits.ichg_10ua));
+		if (ret)
+			goto stop;
+		ret = regmap_update_bits(p->map, REG_INPUT, 0xbf, input);
+		if (ret)
+			goto stop;
+		p->programmed_cv = cv;
+		p->needs_programming = false;
+	}
+	ret = regmap_update_bits(p->map, REG_CONTROL, CHG_ENABLE, CHG_ENABLE);
+	if (!ret)
+		return 0;
+stop:
+	p->needs_programming = true;
+	stop_ret = p00a_disable(p);
+	return stop_ret ? stop_ret : ret;
+}
+
+static int p00a_hw_init(struct p00a_power *p)
+{
+	int ret;
+
+	if (p->initialized)
+		return 0;
+
+	ret = p00a_disable(p);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(p->map, REG_CONTROL, OTG_ENABLE | 0x0e, 0x0c);
+	if (ret)
+		return ret;
+	/* Keep the safety timer and hardware NTC protection; no watchdog reset to defaults. */
+	ret = regmap_update_bits(p->map, REG_TIMER, 0xb8, BIT(7) | BIT(3));
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(p->map, REG_TERM, 0xff, 0x22);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(p->map, REG_ADC, 0x53, BIT(6));
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(p->map, 0x01, 0x1f, 7);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(p->map, REG_INPUT, 0x7f, BIT(6));
+	if (!ret) {
+		p->initialized = true;
+		p->needs_programming = true;
+	}
+	return ret;
+}
+
+static unsigned int p00a_input_cap(enum CHARGER_TYPE type)
+{
+	switch (type) {
+	case STANDARD_HOST:
+		return 500;
+	case CHARGING_HOST:
+		return 1500;
+	case STANDARD_CHARGER:
+	case NONSTANDARD_CHARGER:
+	case APPLE_2_1A_CHARGER:
+	case APPLE_1_0A_CHARGER:
+	case APPLE_0_5A_CHARGER:
+		return 1000;
+	default:
+		return 100;
+	}
+}
+
+static int p00a_command(struct p00a_power *p, int cmd, void *data)
+{
+	unsigned int value, previous;
+	int ret;
+
+	if (cmd < 0 || cmd >= CHARGING_CMD_NUMBER)
+		return -EOPNOTSUPP;
+	if (!data && cmd != CHARGING_CMD_INIT &&
+	    cmd != CHARGING_CMD_DUMP_REGISTER &&
+	    cmd != CHARGING_CMD_RESET_WATCH_DOG_TIMER &&
+	    cmd != CHARGING_CMD_SET_PLATFORM_RESET &&
+	    cmd != CHARGING_CMD_SET_POWER_OFF)
+		return -EINVAL;
+
+	switch (cmd) {
+	case CHARGING_CMD_INIT:
+		return p00a_hw_init(p);
+	case CHARGING_CMD_ENABLE:
+		p->limits.enable_requested = !!*(unsigned int *)data;
+		return p00a_apply(p);
+	case CHARGING_CMD_SET_CV_VOLTAGE:
+		value = *(unsigned int *)data;
+		ret = p00a_cv_code(value);
+		if (ret < 0) {
+			p->limits.cv_uv = 0;
+			p00a_disable(p);
+			return ret;
+		}
+		p->limits.cv_uv = value;
+		p->needs_programming = true;
+		return p00a_apply(p);
+	case CHARGING_CMD_SET_CURRENT:
+		p->limits.ichg_10ua = *(unsigned int *)data;
+		p->needs_programming = true;
+		return p00a_apply(p);
+	case CHARGING_CMD_SET_INPUT_CURRENT:
+		p->limits.input_10ua = *(unsigned int *)data;
+		p->needs_programming = true;
+		ret = p00a_input_code(p->limits.input_10ua, p->limits.input_cap_ma);
+		if (ret < 0) {
+			p00a_disable(p);
+			regmap_update_bits(p->map, REG_INPUT, BIT(7), BIT(7));
+			return ret;
+		}
+		return p00a_apply(p);
+	case CHARGING_CMD_GET_CURRENT:
+		ret = regmap_read(p->map, REG_ICHG, &value);
+		if (ret)
+			return ret;
+		if ((value & 0x7f) > 47)
+			return -EIO;
+		*(unsigned int *)data = (value & 0x7f) * 64;
+		return 0;
+	case CHARGING_CMD_GET_CHARGING_STATUS:
+		ret = regmap_read(p->map, REG_STATUS, &value);
+		if (ret)
+			return ret;
+		*(unsigned int *)data = ((value >> 3) & 3) == 3;
+		return 0;
+	case CHARGING_CMD_RESET_WATCH_DOG_TIMER:
+		return p00a_apply(p);
+	case CHARGING_CMD_GET_CHARGER_TYPE:
+		value = hw_charger_type_detection();
+		p->limits.input_cap_ma = p00a_input_cap(value);
+		p->needs_programming = true;
+		*(unsigned int *)data = value;
+		return 0;
+	case CHARGING_CMD_SET_ERROR_STATE:
+		p->error_state = *(unsigned int *)data;
+		p->limits.error = !!p->error_state;
+		return p00a_apply(p);
+	case CHARGING_CMD_GET_FAULT_TYPE:
+		ret = regmap_read(p->map, REG_FAULT, &previous);
+		if (ret)
+			return ret;
+		ret = regmap_read(p->map, REG_FAULT, &value);
+		if (ret)
+			return ret;
+		*(unsigned int *)data = ((previous | value) >> 4) & 3;
+		return 0;
+	case CHARGING_CMD_GET_VBUS_STAT:
+		ret = regmap_read(p->map, REG_STATUS, &value);
+		if (ret)
+			return ret;
+		value = (value >> 5) & 7;
+		*(unsigned int *)data = value == 7 ? VBUS_STAT_OTG :
+			value == 1 ? VBUS_STAT_SDP : value == 2 ? VBUS_STAT_AC : VBUS_STAT_NONE;
+		return 0;
+	case CHARGING_CMD_GET_SW_AICL_SUPPORT:
+		*(unsigned int *)data = 0;
+		return 0;
+	case CHARGING_CMD_SET_ITERM:
+		value = *(unsigned int *)data;
+		if (!value)
+			return 0;
+		ret = p00a_iterm_code(value);
+		return ret < 0 ? ret : regmap_update_bits(p->map, REG_TERM, 0x0f, ret);
+	case CHARGING_CMD_SET_HV_THRESHOLD:
+		ret = p00a_hv_code(*(unsigned int *)data);
+		if (ret < 0)
+			return ret;
+		upmu_set_rg_vcdt_hv_vth(ret);
+		return 0;
+	case CHARGING_CMD_GET_HV_STATUS:
+		*(bool *)data = upmu_get_rgs_vcdt_hv_det();
+		return 0;
+	case CHARGING_CMD_GET_BATTERY_STATUS:
+		upmu_set_baton_tdet_en(1);
+		upmu_set_rg_baton_en(1);
+		*(bool *)data = upmu_get_rgs_baton_undet();
+		return 0;
+	case CHARGING_CMD_GET_CHARGER_DET_STATUS:
+		*(bool *)data = upmu_get_rgs_chrdet();
+		return 0;
+	case CHARGING_CMD_GET_PLATFORM_BOOT_MODE:
+		*(unsigned int *)data = get_boot_mode();
+		return 0;
+	case CHARGING_CMD_SET_PLATFORM_RESET:
+		orderly_reboot();
+		return 0;
+	case CHARGING_CMD_SET_POWER_OFF:
+		orderly_poweroff(true);
+		return 0;
+	case CHARGING_CMD_GET_POWER_SOURCE:
+		*(bool *)data = false;
+		return 0;
+	case CHARGING_CMD_DUMP_REGISTER:
+		for (value = 0; value <= REG_ID; value++) {
+			ret = regmap_read(p->map, value, &previous);
+			if (ret)
+				return ret;
+			dev_dbg(p->dev, "reg %02x: %02x\n", value, previous);
+		}
+		return 0;
+	case CHARGING_CMD_BOOST_ENABLE:
+		if (*(unsigned int *)data)
+			return -EOPNOTSUPP;
+		return regmap_update_bits(p->map, REG_CONTROL, OTG_ENABLE, 0);
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+
+#endif
