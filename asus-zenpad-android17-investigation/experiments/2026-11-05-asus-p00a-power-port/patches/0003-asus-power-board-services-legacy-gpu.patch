--- /dev/null
+++ b/drivers/misc/mediatek/leds/asus_p00a_lp8557.c
@@ -0,0 +1,165 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* LP8557 initialization sequence comes from the ASUS Z380M GPL LED driver. */
+#include <linux/delay.h>
+#include <linux/gpio.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of_gpio.h>
+#include <linux/spinlock.h>
+#include <linux/workqueue.h>
+
+struct p00a_bl {
+	struct i2c_client *client;
+	struct work_struct work;
+	int gpio;
+	bool configured;
+	bool suspended;
+};
+static DEFINE_SPINLOCK(p00a_bl_lock);
+static struct p00a_bl *p00a_bl_device;
+static unsigned int p00a_bl_requested;
+static bool p00a_bl_has_request;
+
+static int p00a_bl_write(struct p00a_bl *bl, unsigned int reg, unsigned int value)
+{
+	return i2c_smbus_write_byte_data(bl->client, reg, value);
+}
+static int p00a_bl_gate(struct p00a_bl *bl, int enable)
+{
+	return gpio_direction_output(bl->gpio, enable);
+}
+static void p00a_bl_settle(struct p00a_bl *bl)
+{
+	msleep(100);
+}
+#include "asus_p00a_lp8557_core.h"
+
+void asus_p00a_backlight_set(unsigned int level)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&p00a_bl_lock, flags);
+	p00a_bl_requested = level;
+	p00a_bl_has_request = true;
+	if (p00a_bl_device && !p00a_bl_device->suspended)
+		schedule_work(&p00a_bl_device->work);
+	spin_unlock_irqrestore(&p00a_bl_lock, flags);
+}
+
+static void p00a_bl_work(struct work_struct *work)
+{
+	struct p00a_bl *bl = container_of(work, struct p00a_bl, work);
+	unsigned long flags;
+	unsigned int level;
+	bool suspended;
+	int ret;
+
+	spin_lock_irqsave(&p00a_bl_lock, flags);
+	level = p00a_bl_requested;
+	suspended = bl->suspended;
+	spin_unlock_irqrestore(&p00a_bl_lock, flags);
+	ret = p00a_bl_apply(bl, suspended ? 0 : level);
+	if (ret)
+		dev_warn_ratelimited(&bl->client->dev, "backlight I2C/GPIO: %d\n", ret);
+}
+
+static int p00a_bl_probe(struct i2c_client *client, const struct i2c_device_id *id)
+{
+	struct p00a_bl *bl;
+	unsigned long flags;
+	int ret;
+
+	if (!of_machine_is_compatible("asus,p00a"))
+		return -ENODEV;
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_SMBUS_BYTE_DATA))
+		return -EOPNOTSUPP;
+	bl = devm_kzalloc(&client->dev, sizeof(*bl), GFP_KERNEL);
+	if (!bl)
+		return -ENOMEM;
+	bl->client = client;
+	bl->gpio = of_get_named_gpio(client->dev.of_node, "enable-gpios", 0);
+	if (bl->gpio < 0)
+		return bl->gpio;
+	ret = devm_gpio_request(&client->dev, bl->gpio, "asus-lp8557-enable");
+	if (ret)
+		return ret;
+	INIT_WORK(&bl->work, p00a_bl_work);
+	i2c_set_clientdata(client, bl);
+	spin_lock_irqsave(&p00a_bl_lock, flags);
+	if (p00a_bl_device) {
+		spin_unlock_irqrestore(&p00a_bl_lock, flags);
+		return -EBUSY;
+	}
+	p00a_bl_device = bl;
+	if (p00a_bl_has_request)
+		schedule_work(&bl->work);
+	spin_unlock_irqrestore(&p00a_bl_lock, flags);
+	return 0;
+}
+
+static int p00a_bl_remove(struct i2c_client *client)
+{
+	struct p00a_bl *bl = i2c_get_clientdata(client);
+	unsigned long flags;
+
+	spin_lock_irqsave(&p00a_bl_lock, flags);
+	p00a_bl_device = NULL;
+	bl->suspended = true;
+	spin_unlock_irqrestore(&p00a_bl_lock, flags);
+	cancel_work_sync(&bl->work);
+	return p00a_bl_apply(bl, 0);
+}
+
+static int p00a_bl_suspend(struct device *dev)
+{
+	struct p00a_bl *bl = dev_get_drvdata(dev);
+	unsigned long flags;
+	int ret;
+
+	spin_lock_irqsave(&p00a_bl_lock, flags);
+	bl->suspended = true;
+	spin_unlock_irqrestore(&p00a_bl_lock, flags);
+	cancel_work_sync(&bl->work);
+	ret = p00a_bl_apply(bl, 0);
+	if (ret) {
+		spin_lock_irqsave(&p00a_bl_lock, flags);
+		bl->suspended = false;
+		spin_unlock_irqrestore(&p00a_bl_lock, flags);
+	}
+	return ret;
+}
+
+static int p00a_bl_resume(struct device *dev)
+{
+	struct p00a_bl *bl = dev_get_drvdata(dev);
+	unsigned long flags;
+
+	spin_lock_irqsave(&p00a_bl_lock, flags);
+	bl->configured = false;
+	bl->suspended = false;
+	if (p00a_bl_has_request)
+		schedule_work(&bl->work);
+	spin_unlock_irqrestore(&p00a_bl_lock, flags);
+	return 0;
+}
+
+static const struct dev_pm_ops p00a_bl_pm = {
+	SET_SYSTEM_SLEEP_PM_OPS(p00a_bl_suspend, p00a_bl_resume)
+};
+static const struct of_device_id p00a_bl_match[] = {
+	{ .compatible = "ti,lp8557-led" },
+	{ .compatible = "ti,lp8557_led" }, {}
+};
+MODULE_DEVICE_TABLE(of, p00a_bl_match);
+static const struct i2c_device_id p00a_bl_ids[] = { { "lp8557-led", 0 }, {} };
+MODULE_DEVICE_TABLE(i2c, p00a_bl_ids);
+static struct i2c_driver p00a_bl_driver = {
+	.driver = { .name = "asus-p00a-lp8557", .of_match_table = p00a_bl_match,
+		.pm = &p00a_bl_pm },
+	.probe = p00a_bl_probe,
+	.remove = p00a_bl_remove,
+	.id_table = p00a_bl_ids,
+};
+module_i2c_driver(p00a_bl_driver);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("ASUS P00A LP8557 enable bridge for MediaTek PWM backlight");
--- /dev/null
+++ b/drivers/misc/mediatek/leds/asus_p00a_lp8557_core.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef ASUS_P00A_LP8557_CORE_H
+#define ASUS_P00A_LP8557_CORE_H
+
+static int p00a_bl_apply(struct p00a_bl *bl, unsigned int level)
+{
+	int ret, off_ret;
+
+	if (!level) {
+		ret = p00a_bl_write(bl, 0x00, 0);
+		off_ret = p00a_bl_gate(bl, 0);
+		bl->configured = false;
+		return ret ? ret : off_ret;
+	}
+	if (bl->configured)
+		return 0;
+	ret = p00a_bl_gate(bl, 1);
+	if (ret)
+		goto fail;
+	p00a_bl_settle(bl);
+	ret = p00a_bl_write(bl, 0x10, 0x04);
+	if (ret)
+		goto fail;
+	ret = p00a_bl_write(bl, 0x14, 0xdf);
+	if (ret)
+		goto fail;
+	ret = p00a_bl_write(bl, 0x04, 0xff);
+	if (ret)
+		goto fail;
+	ret = p00a_bl_write(bl, 0x00, 0x01);
+	if (ret)
+		goto fail;
+	bl->configured = true;
+	return 0;
+fail:
+	p00a_bl_write(bl, 0x00, 0);
+	p00a_bl_gate(bl, 0);
+	bl->configured = false;
+	return ret;
+}
+#endif
