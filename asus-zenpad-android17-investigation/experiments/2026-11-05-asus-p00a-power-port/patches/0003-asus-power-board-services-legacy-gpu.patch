+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef ASUS_P00A_POWER_POLICY_H
+#define ASUS_P00A_POWER_POLICY_H
+
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#include <linux/types.h>
+#else
+#include <stdbool.h>
+#include <errno.h>
+#endif
+
+#define P00A_CV_MAX_UV 4352000U
+#define P00A_CV_WARM_UV 4304000U
+#define P00A_ICHG_MAX_MA 1920U
+#define P00A_ITERM_MAX_MA 192U
+
+struct p00a_limits {
+	unsigned int cv_uv;
+	unsigned int ichg_10ua;
+	unsigned int input_10ua;
+	unsigned int input_cap_ma;
+	unsigned int ts_raw;
+	unsigned int fault;
+	int temp_c;
+	bool battery_present;
+	bool charger_present;
+	bool sensors_valid;
+	bool enable_requested;
+	bool charging_permitted;
+	bool suspended;
+	bool thermal_latched;
+	bool error;
+};
+
+static inline int p00a_cv_code(unsigned int uv)
+{
+	if (uv < 3840000U)
+		return -ERANGE;
+	if (uv > P00A_CV_MAX_UV)
+		uv = P00A_CV_MAX_UV;
+	return (uv - 3840000U) / 16000U;
+}
+
+static inline unsigned int p00a_ichg_code(unsigned int current_10ua)
+{
+	unsigned int ma = current_10ua / 100U;
+
+	if (ma > P00A_ICHG_MAX_MA)
+		ma = P00A_ICHG_MAX_MA;
+	return ma / 64U;
+}
+
+static inline int p00a_input_code(unsigned int current_10ua,
+				 unsigned int cap_ma)
+{
+	unsigned int ma = current_10ua / 100U;
+
+	if (ma > cap_ma)
+		ma = cap_ma;
+	if (ma < 100U)
+		return -ERANGE;
+	if (ma > 1500U)
+		ma = 1500U;
+	return (ma - 100U) / 50U;
+}
+
+static inline int p00a_iterm_code(unsigned int ma)
+{
+	if (ma < 64U)
+		return -ERANGE;
+	if (ma > P00A_ITERM_MAX_MA)
+		ma = P00A_ITERM_MAX_MA;
+	return (ma - 64U) / 64U;
+}
+
+static inline int p00a_hv_code(unsigned int uv)
+{
+	static const unsigned int levels[] = {
+		4200000, 4250000, 4300000, 4350000,
+		4400000, 4450000, 4500000, 4550000,
+		4600000, 6000000, 6500000
+	};
+	int i;
+
+	if (uv < levels[0])
+		return -ERANGE;
+	for (i = 10; i > 0; i--)
+		if (levels[i] <= uv)
+			return i;
+	return 0;
+}
+
+static inline bool p00a_fault_blocks(unsigned int fault)
+{
+	unsigned int ntc = fault & 7U;
+
+	return (fault & 0xf8U) || (ntc != 0 && ntc != 2 && ntc != 3);
+}
+
+static inline bool p00a_can_charge(struct p00a_limits *p)
+{
+	if (!p->sensors_valid || p->temp_c <= 0 || p->temp_c >= 50)
+		p->thermal_latched = true;
+	else if (p->thermal_latched && p->temp_c > 6 && p->temp_c < 47)
+		p->thermal_latched = false;
+
+	return p->charging_permitted && p->enable_requested &&
+		!p->suspended && !p->thermal_latched && !p->error &&
+		p->battery_present && p->charger_present && p->sensors_valid &&
+		p->ts_raw > 0 && p->ts_raw < 127 &&
+		!p00a_fault_blocks(p->fault) &&
+		p00a_cv_code(p->cv_uv) >= 0 &&
+		p00a_ichg_code(p->ichg_10ua) > 0 &&
+		p00a_input_code(p->input_10ua, p->input_cap_ma) >= 0;
+}
+
+static inline int p00a_effective_cv(struct p00a_limits *p)
+{
+	unsigned int uv = p->cv_uv;
+
+	if ((p->temp_c >= 45 || p->ts_raw <= 51) && uv > P00A_CV_WARM_UV)
+		uv = P00A_CV_WARM_UV;
+	return p00a_cv_code(uv);
+}
+
