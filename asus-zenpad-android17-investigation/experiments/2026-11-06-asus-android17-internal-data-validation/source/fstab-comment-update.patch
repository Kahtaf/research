 # Header-0 ramdisk, no super/vendor/product partitions on this tablet.
 /dev/block/platform/soc/11230000.mmc/by-name/system /system ext4 ro wait,first_stage_mount
 
-# Original userdata is FDE encrypted. This does not decrypt or format it.
