+  ps_total, ps_total ? (ps_total - 1) / PS_RING : 0,
+  min_t(u64, ps_total, PS_RING), 0, nr_cpu_ids};
+ unsigned int i;
+ memset(line, ' ', sizeof(line));
+ memcpy(line, "!A49PH ", 7);
+ for (i = 0; i < ARRAY_SIZE(f); ++i)
+  cap_hex(line + 9 + i * 17, f[i], 16);
+ cap_hex(line + 160, f[0], 16);
+ line[191] = '\n';
