diff --git a/drivers/power/supply/mediatek/battery/asus_p00a_soc.inc b/drivers/power/supply/mediatek/battery/asus_p00a_soc.inc
new file mode 100644
index 0000000000000000000000000000000000000000..a951d7e78faf16b6df1df9018c8ee93e0ae4c973
--- /dev/null
+++ b/drivers/power/supply/mediatek/battery/asus_p00a_soc.inc
@@ -0,0 +1,309 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* ASUS P00A OAM D2 transaction.
+ *
+ * D2 is selected by the original ASUS DT (oam_d5 = 0). Its independent
+ * recurrence is taken from ASUS 3.18 battery_meter.c:oam_init/oam_run and
+ * retained in this kernel's OAM: I2=(OCV2-VBAT)*10000/R2, CAR2+=I2*dt/3600,
+ * D2=D0+CAR2*10/Qmax, OCV2=V(D2), R2=R(OCV2). D1/D3/D5 do not feed D2.
+ * The existing fgauge_* lookups and four-temperature interpolation below
+ * are used unchanged apart from repeated-point/endpoint safety fixes.
+ *
+ * Only this transaction may advance the board model. No RTC/UI percentage,
+ * charger programmed current, cover gauge or assumed sleep current is input.
+ * The boot seed uses ASUS's measured-VBAT fallback, not an unqualified PMIC
+ * wakeup latch. This is an OAM estimate, not a measured coulomb counter.
+ */
+#if defined(CONFIG_MTK_MULTI_BAT_PROFILE_SUPPORT) || \
+    defined(CONFIG_MTK_BATTERY_LIFETIME_DATA_SUPPORT) || \
+    defined(CUST_CAPACITY_OCV2CV_TRANSFORM) || defined(CONFIG_POWER_EXT)
+#error "P00A SOC requires the single ASUS D2 model without unsupported transforms"
+#endif
+#ifndef SOC_BY_SW_FG
+#error "P00A SOC requires SOC_BY_SW_FG"
+#endif
+
+#define P00A_SAMPLE_MAX_MS 2000
+#define P00A_SOC_MAX_AGE_MS 30000
+
+struct p00a_oam_state {
+	bool initialized;
+	bool valid;
+	bool suspended;
+	int error;
+	int d0;
+	int ocv2;
+	int r2;
+	s64 car2;
+	s64 last_ms;
+	struct asus_p00a_battery_sample sample;
+};
+
+/* All fields, including model construction, are protected by FGADC_mutex. */
+static struct p00a_oam_state p00a_oam = { .error = -EAGAIN };
+
+static s64 p00a_now_ms(void)
+{
+	struct timespec now;
+
+	get_monotonic_boottime(&now);
+	return (s64)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
+
+static void p00a_soc_fault_locked(int error)
+{
+	p00a_oam.valid = false;
+	p00a_oam.initialized = false;
+	p00a_oam.error = error < 0 ? error : -EIO;
+}
+
+void asus_p00a_soc_invalidate(int error)
+{
+	mutex_lock(&FGADC_mutex);
+	p00a_soc_fault_locked(error);
+	mutex_unlock(&FGADC_mutex);
+}
+
+void asus_p00a_soc_suspend(bool suspended)
+{
+	mutex_lock(&FGADC_mutex);
+	p00a_oam.suspended = suspended;
+	/* Never integrate an unobserved suspend interval or reuse its SOC. */
+	p00a_soc_fault_locked(suspended ? -EHOSTDOWN : -EAGAIN);
+	mutex_unlock(&FGADC_mutex);
+}
+
+static int p00a_validate_dt(const struct device_node *np)
+{
+	static const char * const profiles[] = {
+		"battery_profile_t0", "battery_profile_t1",
+		"battery_profile_t2", "battery_profile_t3",
+		"r_profile_t0", "r_profile_t1", "r_profile_t2", "r_profile_t3"
+	};
+	static const char * const qmax[] = {
+		"q_max_neg_10", "q_max_pos_0", "q_max_pos_25", "q_max_pos_50",
+		"q_max_neg_10_h_current", "q_max_pos_0_h_current",
+		"q_max_pos_25_h_current", "q_max_pos_50_h_current"
+	};
+	static const struct { const char *name; u32 value; } settings[] = {
+		{ "temperature_t0", 110 }, { "temperature_t1", 0 },
+		{ "temperature_t2", 25 }, { "temperature_t3", 50 },
+		{ "temperature_t", 255 }, { "oam_d5", 0 },
+		{ "vbat_channel_number", 6 }, { "vbattemp_channel_number", 5 },
+		{ "swchr_power_path", 1 }
+	};
+	u32 x, v, previous_x, previous_v, first_v;
+	char count_name[32];
+	int table, i;
+
+	BUILD_BUG_ON(PROFILE_TABLE_SIZE != 104);
+	for (i = 0; i < ARRAY_SIZE(settings); i++)
+		if (of_property_read_u32(np, settings[i].name, &x) ||
+		    x != settings[i].value)
+			return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(qmax); i++)
+		if (of_property_read_u32(np, qmax[i], &x) || !x || x > 10000)
+			return -EINVAL;
+	for (table = 0; table < ARRAY_SIZE(profiles); table++) {
+		snprintf(count_name, sizeof(count_name), "%s_num", profiles[table]);
+		if (of_property_read_u32(np, count_name, &x) || x != PROFILE_TABLE_SIZE)
+			return -EINVAL;
+		if (of_property_count_u32_elems(np, profiles[table]) !=
+		    PROFILE_TABLE_SIZE * 2)
+			return -EINVAL;
+		first_v = 0;
+		previous_x = 0;
+		previous_v = 5000;
+		for (i = 0; i < PROFILE_TABLE_SIZE; i++) {
+			if (of_property_read_u32_index(np, profiles[table], i * 2, &x) ||
+			    of_property_read_u32_index(np, profiles[table], i * 2 + 1, &v))
+				return -EINVAL;
+			if (v < 2000 || v > 5000 || v > previous_v)
+				return -EINVAL;
+			if (!i)
+				first_v = v;
+			if (i == PROFILE_TABLE_SIZE - 1 && v >= first_v)
+				return -EINVAL;
+			if (table < 4) {
+				if (x > 100 || x < previous_x || (!i && x) ||
+				    (i == PROFILE_TABLE_SIZE - 1 && x != 100))
+					return -EINVAL;
+			} else if (!x || x > 10000) {
+				return -EINVAL;
+			}
+			previous_x = x;
+			previous_v = v;
+		}
+	}
+	return 0;
+}
+
+static int p00a_capture(struct asus_p00a_battery_sample *sample, s64 *time_ms)
+{
+	s64 start = p00a_now_ms(), end;
+	int ret = asus_p00a_battery_read_sample(sample);
+
+	if (ret)
+		return ret;
+	end = p00a_now_ms();
+	if (end < start || end - start > P00A_SAMPLE_MAX_MS)
+		return -ESTALE;
+	*time_ms = end;
+	return 0;
+}
+
+static int p00a_construct_model(int decic)
+{
+	int temperature = decic / 10;
+
+	fgauge_construct_r_table_profile(temperature, r_profile_temperature);
+	fgauge_construct_battery_profile(temperature, battery_profile_temperature);
+	return fgauge_get_Q_max(temperature);
+}
+
+static int p00a_oam_seed(const struct asus_p00a_battery_sample *sample, s64 now)
+{
+	int qmax = p00a_construct_model(sample->temperature_decic);
+	int d0 = fgauge_read_d_by_v(sample->voltage_mv);
+	int ocv = fgauge_read_v_by_d(d0);
+	int resistance = fgauge_read_r_bat_by_v(sample->voltage_mv);
+
+	if (qmax <= 0 || d0 < 0 || d0 > 100 || ocv < 2000 || ocv > 5000 ||
+	    resistance <= 0)
+		return -ERANGE;
+	p00a_oam.d0 = d0;
+	p00a_oam.ocv2 = ocv;
+	p00a_oam.r2 = resistance;
+	p00a_oam.car2 = 0;
+	p00a_oam.last_ms = now;
+	p00a_oam.initialized = true;
+	p00a_oam.valid = false;
+	p00a_oam.error = -EAGAIN;
+	return 0;
+}
+
+static int p00a_oam_step(struct asus_p00a_battery_sample *sample, s64 now)
+{
+	s64 delta_ms = now - p00a_oam.last_ms;
+	s64 current, car, dod;
+	int delta, qmax, ocv, resistance;
+
+	if (!p00a_oam.initialized)
+		return -EAGAIN;
+	if (delta_ms < 0 || delta_ms > P00A_SOC_MAX_AGE_MS)
+		return -ESTALE;
+	delta = div_s64(delta_ms, 1000);
+	if (!delta)
+		return -EAGAIN;
+	qmax = p00a_construct_model(sample->temperature_decic);
+	if (qmax <= 0 || p00a_oam.r2 <= 0)
+		return -ERANGE;
+	/* Exact ASUS OAM D2 recurrence, widened before arithmetic. */
+	current = div_s64((s64)(p00a_oam.ocv2 - sample->voltage_mv) * 10000,
+			 p00a_oam.r2);
+	car = p00a_oam.car2 + div_s64(current * delta, 3600);
+	/* Bound the accumulator before multiplication even on multi-year uptime. */
+	if (car > INT_MAX || car < -INT_MAX)
+		return -ERANGE;
+	dod = p00a_oam.d0 + div_s64(car * 10, qmax);
+	dod = clamp_t(s64, dod, 0, 100);
+	ocv = fgauge_read_v_by_d(dod);
+	resistance = fgauge_read_r_bat_by_v(ocv);
+	if (ocv < 2000 || ocv > 5000 || resistance <= 0)
+		return -ERANGE;
+	/* Commit only after every model output passes validation. */
+	p00a_oam.car2 = car;
+	p00a_oam.ocv2 = ocv;
+	p00a_oam.r2 = resistance;
+	p00a_oam.last_ms = now;
+	sample->capacity = 100 - dod;
+	p00a_oam.sample = *sample;
+	p00a_oam.valid = true;
+	p00a_oam.error = 0;
+	return 0;
+}
+
+int asus_p00a_soc_update(void)
+{
+	struct asus_p00a_battery_sample sample;
+	unsigned int charging_enable = false;
+	s64 now;
+	int ret;
+
+	mutex_lock(&FGADC_mutex);
+	if (p00a_oam.suspended) {
+		ret = -EHOSTDOWN;
+		goto fault;
+	}
+	if (!p00a_model_ready || !battery_charging_control) {
+		ret = -EAGAIN;
+		goto fault;
+	}
+	ret = battery_charging_control(CHARGING_CMD_ENABLE, &charging_enable);
+	if (ret)
+		goto fault;
+	ret = asus_p00a_pmic_enable_baton();
+	if (ret)
+		goto fault;
+	/* Same charging-off settling interval used by ASUS oam_init(). */
+	msleep(50);
+	ret = p00a_capture(&sample, &now);
+	if (ret)
+		goto fault;
+	if (p00a_oam.initialized && (now < p00a_oam.last_ms ||
+	    now - p00a_oam.last_ms > P00A_SOC_MAX_AGE_MS))
+		p00a_soc_fault_locked(-ESTALE);
+	if (!p00a_oam.initialized) {
+		ret = p00a_oam_seed(&sample, now);
+		if (ret)
+			goto fault;
+		/* Initialization alone is not a SOC update. A second actual sample
+		 * and positive elapsed time are required before publication. PM
+		 * suspend takes this same lock, then invalidates before suspending.
+		 */
+		msleep(1100);
+		ret = p00a_capture(&sample, &now);
+		if (ret)
+			goto fault;
+	}
+	if (now >= p00a_oam.last_ms && now - p00a_oam.last_ms < 1000) {
+		/* A repeated caller must not advance or refresh the sample age. */
+		ret = p00a_oam.valid ? 0 : -EAGAIN;
+		goto out;
+	}
+	ret = p00a_oam_step(&sample, now);
+	if (ret)
+		goto fault;
+	goto out;
+fault:
+	p00a_soc_fault_locked(ret);
+out:
+	mutex_unlock(&FGADC_mutex);
+	return ret;
+}
+
+int asus_p00a_soc_read(struct asus_p00a_battery_sample *sample)
+{
+	s64 now;
+	int ret;
+
+	mutex_lock(&FGADC_mutex);
+	now = p00a_now_ms();
+	if (p00a_oam.valid && (now < p00a_oam.last_ms ||
+	    now - p00a_oam.last_ms > P00A_SOC_MAX_AGE_MS))
+		p00a_soc_fault_locked(-ESTALE);
+	ret = p00a_oam.valid ? 0 : p00a_oam.error;
+	if (!ret)
+		*sample = p00a_oam.sample;
+	mutex_unlock(&FGADC_mutex);
+	return ret;
+}
+
+int asus_p00a_soc_capacity(int *capacity)
+{
+	struct asus_p00a_battery_sample sample;
+	int ret = asus_p00a_soc_read(&sample);
+
+	if (!ret)
+		*capacity = sample.capacity;
+	return ret;
+}
