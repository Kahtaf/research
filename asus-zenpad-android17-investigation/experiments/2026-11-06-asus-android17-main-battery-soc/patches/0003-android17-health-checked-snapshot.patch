diff --git a/health/aidl/default/HalHealthLoop.cpp b/health/aidl/default/HalHealthLoop.cpp
index ec23c10bc0d4d557fa07ee5830d9a3b2fc27d8b1..cfb2f5d72f61b384405d8528cfaeb095784be1b7 100644
--- a/health/aidl/default/HalHealthLoop.cpp
+++ b/health/aidl/default/HalHealthLoop.cpp
@@ -44,8 +44,14 @@ void HalHealthLoop::ScheduleBatteryUpdate() {
 
     HealthInfo health_info;
     auto res = service_->getHealthInfo(&health_info);
-    CHECK(res.isOk()) << "getHealthInfo() on the health HAL implementation failed with "
-                      << res.getDescription();
+    if (!res.isOk()) {
+        LOG(WARNING) << "getHealthInfo() unavailable; retaining callbacks and retrying: "
+                     << res.getDescription();
+        // Do not deliver an invalid aggregate or terminate the service. Keep
+        // periodic updates running, using the last observed charger state.
+        AdjustWakealarmPeriods(charger_online());
+        return;
+    }
     OnHealthInfoChanged(health_info);
 }
 
