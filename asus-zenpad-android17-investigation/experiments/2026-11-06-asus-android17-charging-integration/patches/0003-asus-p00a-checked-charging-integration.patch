diff --git a/drivers/misc/mediatek/power/mt8163/asus_p00a/charge_snapshot.inc b/drivers/misc/mediatek/power/mt8163/asus_p00a/charge_snapshot.inc
new file mode 100644
index 0000000000000000000000000000000000000000..f8e0db524d5ed322c65e8e4267dc102c41e78e69
--- /dev/null
+++ b/drivers/misc/mediatek/power/mt8163/asus_p00a/charge_snapshot.inc
@@ -0,0 +1,149 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Charger owns the published copy. No entry here takes FGADC_mutex or calls
+ * the SOC/measurement getters. All hardware operations retain p->lock.
+ */
+#ifdef CONFIG_ASUS_P00A_MAIN_BATTERY_SOC
+int asus_p00a_charge_publish(const struct asus_p00a_battery_sample *sample,
+			   s64 sampled_ms, int error)
+{
+	int ret;
+
+	mutex_lock(&p00a_global_lock);
+	if (!p00a) {
+		ret = -ENODEV;
+		goto out;
+	}
+	mutex_lock(&p00a->lock);
+	ret = p00a_publish_locked(p00a, sample, sampled_ms, error);
+	mutex_unlock(&p00a->lock);
+out:
+	mutex_unlock(&p00a_global_lock);
+	return ret;
+}
+
+int asus_p00a_charge_source_changed(void)
+{
+	int ret;
+
+	/* Called by the threaded PMIC CHRDET callback, outside pmic_lock.
+	 * Even a rapid unplug/replug with identical REG0B invalidates its cap.
+	 */
+	mutex_lock(&p00a_global_lock);
+	if (!p00a) {
+		ret = -ENODEV;
+		goto out;
+	}
+	mutex_lock(&p00a->lock);
+	p00a->generation++;
+	p00a->sample_valid = false;
+	p00a->limits.sensors_valid = false;
+	p00a->limits.enable_requested = false;
+	p00a->limits.input_cap_ma = 100;
+	p00a->source_seen = false;
+	p00a->source_classified = false;
+	p00a->needs_programming = true;
+	if (p00a->limits.suspended || p00a->stopped)
+		ret = -EHOSTDOWN;
+	else {
+		ret = p00a_disable(p00a);
+		if (!ret)
+			ret = p00a_write_checked(p00a, REG_INPUT, 0x7f, BIT(6));
+	}
+	mutex_unlock(&p00a->lock);
+out:
+	mutex_unlock(&p00a_global_lock);
+	return ret;
+}
+
+int asus_p00a_charge_request(bool usb_ready)
+{
+	unsigned int type;
+	int ret;
+
+	mutex_lock(&p00a_global_lock);
+	if (!p00a) {
+		ret = -ENODEV;
+		goto out;
+	}
+	mutex_lock(&p00a->lock);
+	if (!p00a->source_classified && usb_ready) {
+		ret = p00a_command(p00a, CHARGING_CMD_GET_CHARGER_TYPE, &type);
+		if (ret) {
+			mutex_unlock(&p00a->lock);
+			goto out;
+		}
+	}
+	/* A conservative fixed request, not calibration or a new board model.
+	 * Source-specific ceilings still use the reviewed policy. Unknown=100mA.
+	 * Activation requires the separately reviewed DT permission.
+	 */
+	p00a->limits.cv_uv = 4208000;
+	p00a->limits.ichg_10ua = 51200;
+	p00a->limits.input_10ua = p00a->limits.input_cap_ma * 100;
+	p00a->limits.enable_requested = true;
+	p00a->needs_programming = true;
+	ret = p00a_apply(p00a);
+	mutex_unlock(&p00a->lock);
+out:
+	mutex_unlock(&p00a_global_lock);
+	return ret;
+}
+#endif
+
+/* No REG0C read here: only the guard consumes that latch. Values labelled
+ * limit are programmed limits, never measured battery/net charging current.
+ * Raw TS/ADC telemetry has no independent freshness claim.
+ */
+static ssize_t charge_guard_show(struct device *dev,
+				struct device_attribute *attr, char *buf)
+{
+	struct p00a_power *p = dev_get_drvdata(dev);
+	unsigned int r[REG_ID + 1] = { 0 };
+	int i, ret = 0;
+	s64 now;
+
+	mutex_lock(&p->lock);
+	if (p->limits.suspended || p->stopped) {
+		ret = -EHOSTDOWN;
+		goto out;
+	}
+	for (i = 0; i <= REG_ID; i++) {
+		if (i == REG_FAULT)
+			continue;
+		ret = regmap_read(p->map, i, &r[i]);
+		if (ret) {
+			p->sample_valid = false;
+			p->guard_error = ret;
+			p00a_disable(p);
+			goto out;
+		}
+	}
+	now = p00a_clock_ms();
+	ret = scnprintf(buf, PAGE_SIZE,
+		"enabled=%u pg=%u charge_state=%u cv_limit_uv=%u ichg_limit_ma=%u input_limit_ma=%u\n"
+		"sample_valid=%u sample_age_ms=%lld generation=%llu guard_error=%d disable_error=%d suspended=%u\n"
+		"fault_previous=0x%02x fault_current=0x%02x fault_latched=0x%02x fault_error=%d fault_age_ms=%lld\n"
+		"adc_valid=%u adc_age_ms=%lld charger_branch_current_valid=%u charger_branch_current_ma=%u\n"
+		"input=0x%02x adc=0x%02x control=0x%02x timer=0x%02x compensation=0x%02x ts_raw=%u thermal=%u dpm=0x%02x id=0x%02x\n",
+		!!(r[REG_CONTROL] & CHG_ENABLE), !!(r[REG_STATUS] & BIT(2)),
+		(r[REG_STATUS] >> 3) & 3, 3840000 + (r[REG_CV] >> 2) * 16000,
+		(r[REG_ICHG] & 0x7f) * 64, 100 + (r[REG_INPUT] & 0x3f) * 50,
+		p->sample_valid && now >= p->sample_ms && now - p->sample_ms < 30000,
+		(long long)(now - p->sample_ms), (unsigned long long)p->generation,
+		p->guard_error, p->disable_error, p->limits.suspended,
+		p->fault_previous, p->fault_current, p->fault_latched, p->fault_error,
+		(long long)(now - p->fault_ms),
+		p->adc_valid && now >= p->adc_ms && now - p->adc_ms < 10000,
+		(long long)(now - p->adc_ms),
+		p->adc_current_valid && p->adc_valid && now >= p->adc_ms &&
+		now - p->adc_ms < 10000 && !!(r[REG_CONTROL] & CHG_ENABLE) &&
+		!!(r[REG_STATUS] & BIT(2)) && ((r[REG_STATUS] >> 3) & 3) != 0 &&
+		((r[REG_STATUS] >> 3) & 3) != 3,
+		p->adc_charge_ma, r[REG_INPUT], r[REG_ADC],
+		r[REG_CONTROL], r[REG_TIMER], r[0x08], r[REG_TS] & 0x7f,
+		!!(r[0x0e] & BIT(7)), r[0x13], r[REG_ID]);
+out:
+	mutex_unlock(&p->lock);
+	return ret;
+}
+static DEVICE_ATTR_RO(charge_guard);
diff --git a/drivers/misc/mediatek/power/mt8163/asus_p00a/control.h b/drivers/misc/mediatek/power/mt8163/asus_p00a/control.h
index fb71747a4e3441ab0936c41fd07fdbc676a30196..77e459392605cd90b251a84a7065f7b7ca6300f2 100644
--- a/drivers/misc/mediatek/power/mt8163/asus_p00a/control.h
+++ b/drivers/misc/mediatek/power/mt8163/asus_p00a/control.h
@@ -2,53 +2,388 @@
 #ifndef ASUS_P00A_POWER_CONTROL_H
 #define ASUS_P00A_POWER_CONTROL_H
 
+static int p00a_verify(struct p00a_power *p, unsigned int reg,
+		       unsigned int mask, unsigned int expected)
+{
+	unsigned int value;
+	int ret = regmap_read(p->map, reg, &value);
+
+	return ret ? ret : ((value & mask) == expected ? 0 : -EIO);
+}
+
+static int p00a_write_checked(struct p00a_power *p, unsigned int reg,
+			      unsigned int mask, unsigned int value)
+{
+	int ret = regmap_update_bits(p->map, reg, mask, value);
+
+	return ret ? ret : p00a_verify(p, reg, mask, value);
+}
+
+static void p00a_awake(struct p00a_power *p, bool awake)
+{
+	if (p->awake == awake)
+		return;
+	p->awake = awake;
+	if (awake)
+		pm_stay_awake(p->dev);
+	else
+		pm_relax(p->dev);
+}
+
 static int p00a_disable(struct p00a_power *p)
 {
-	return regmap_update_bits(p->map, REG_CONTROL, CHG_ENABLE, 0);
+	int ret, read_ret;
+
+	ret = regmap_update_bits(p->map, REG_CONTROL, CHG_ENABLE | OTG_ENABLE, 0);
+	/* Read even after a failed write; retain the transport error. A zero
+	 * readback cannot turn a failed operation into a successful ack.
