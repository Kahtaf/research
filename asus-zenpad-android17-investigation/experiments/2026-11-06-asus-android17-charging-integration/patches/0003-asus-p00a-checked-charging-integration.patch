index 0000000000000000000000000000000000000000..9849457bbe969a6f986dde7bf0de54433cd0945f
--- /dev/null
+++ b/drivers/misc/mediatek/power/mt8163/asus_p00a/bc12.inc
@@ -0,0 +1,108 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* MT8163 BC1.2 sequence from pmic_chr_type_det.c, with checked PMIC
+ * transactions. Called with the pad charger lock held; no SOC/BQ callback.
+ * USB PHY init/release retain the platform MMIO ABI (no status return).
+ */
+#include <mt-plat/charging.h>
+extern void Charger_Detect_Init(void);
+extern void Charger_Detect_Release(void);
+static DEFINE_MUTEX(p00a_bc12_lock);
+
+static int p00a_bc12_write(unsigned int reg, unsigned int mask,
+			   unsigned int value)
+{
+	unsigned int actual;
+	int ret;
+
+	pmic_lock();
+	ret = p00a_pmic_result(pmic_config_interface(reg, value, mask, 0));
+	if (!ret)
+		ret = p00a_pmic_result(pmic_read_interface(reg, &actual, mask, 0));
+	if (!ret && actual != value)
+		ret = -EIO;
+	pmic_unlock();
+	return ret;
+}
+
+static int p00a_bc12_read(unsigned int *result)
+{
+	int ret;
+
+	msleep(80);
+	pmic_lock();
+	ret = p00a_pmic_result(pmic_read_interface(CHR_CON18, result,
+		PMIC_RGS_BC11_CMP_OUT_MASK, PMIC_RGS_BC11_CMP_OUT_SHIFT));
+	pmic_unlock();
+	return ret;
+}
+
+int asus_p00a_bc12_type(unsigned int *type)
+{
+	unsigned int cmp, next = CHARGER_UNKNOWN;
+	int ret, cleanup, cleanup2;
+
+	if (!READ_ONCE(pwrap_regmap))
+		return -ENODATA;
+	mutex_lock(&p00a_bc12_lock);
+	Charger_Detect_Init();
+	/* CHR_CON18: BB_CTRL, RST, VSRC. CHR_CON19: VREF, CMP, IPD,
+	 * IPU, BIAS. Preserve unrelated fields, including comparator output.
+	 */
+	ret = p00a_bc12_write(CHR_CON19, 0x1ff, 0x100);
+	if (ret)
+		goto out;
+	ret = p00a_bc12_write(CHR_CON18, 0x0f, 3);
+	if (ret)
+		goto out;
+	msleep(50);
+	/* DCD: IPU=2, IPD=1, VREF=1, CMP=2. */
+	ret = p00a_bc12_write(CHR_CON19, 0xff, 0x99);
+	if (ret)
+		goto out;
+	ret = p00a_bc12_read(&cmp);
+	if (ret)
+		goto out;
+	ret = p00a_bc12_write(CHR_CON19, 0xff, 0);
+	if (ret)
+		goto out;
+	if (cmp) {
+		next = NONSTANDARD_CHARGER;
+		goto out;
+	}
+	/* A2: VSRC=2, IPD=1, CMP=1. */
+	ret = p00a_bc12_write(CHR_CON18, 0x0c, 8);
+	if (ret)
+		goto out;
+	ret = p00a_bc12_write(CHR_CON19, 0xff, 0x14);
+	if (ret)
+		goto out;
+	ret = p00a_bc12_read(&cmp);
+	if (ret)
+		goto out;
+	ret = p00a_bc12_write(CHR_CON18, 0x0c, 0);
+	if (ret)
+		goto out;
+	ret = p00a_bc12_write(CHR_CON19, 0xff, 0);
+	if (ret)
+		goto out;
+	if (!cmp) {
+		next = STANDARD_HOST;
+		goto out;
+	}
+	/* B2: IPU=2, VREF=1, CMP=1 (actual source uses 1, not comment's 2). */
+	ret = p00a_bc12_write(CHR_CON19, 0xff, 0x85);
+	if (ret)
+		goto out;
+	ret = p00a_bc12_read(&cmp);
+	if (!ret)
+		next = cmp ? STANDARD_CHARGER : CHARGING_HOST;
+out:
+	cleanup = p00a_bc12_write(CHR_CON18, 0x0c, 0);
+	cleanup2 = p00a_bc12_write(CHR_CON19, 0x1ff, 0);
+	Charger_Detect_Release();
+	mutex_unlock(&p00a_bc12_lock);
+	if (ret || cleanup || cleanup2)
+		return ret ? ret : (cleanup ? cleanup : cleanup2);
+	*type = next;
+	return 0;
+}
