+		b->u4WriteIdx = offset >= size - bytes ?
+			offset - (size - bytes) : offset + bytes;
+		b->u4DataRemained += bytes;
+	}
+	(*generation)++;
+	err = 0;
+ring_out:
+	spin_unlock(&control->substream_lock);
+stream_out:
+	snd_pcm_stream_unlock_irqrestore(substream, flags);
+free_out:
+	kfree(staging);
+	return err;
+}
