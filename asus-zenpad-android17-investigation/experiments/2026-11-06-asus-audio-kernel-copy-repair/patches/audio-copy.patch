+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef MT_SOC_PCM_TRANSFER_H
+#define MT_SOC_PCM_TRANSFER_H
+
+#include <linux/slab.h>
+#include <linux/mutex.h>
+#include <linux/io.h>
+#include <linux/uaccess.h>
+
+/* Byte accounting must describe the negotiated ALSA ring, not a format guess. */
+static bool mtk_pcm_ring_valid(struct snd_pcm_runtime *runtime,
+			       const struct AFE_BLOCK_T *b)
+{
+	unsigned int frame_bytes = runtime->frame_bits / 8;
+
+	if (!frame_bytes || runtime->frame_bits % 8 ||
+	    b->u4BufferSize <= 0 || !b->pucVirtBufAddr ||
+	    runtime->buffer_size > INT_MAX / frame_bytes ||
+	    runtime->buffer_size * frame_bytes != b->u4BufferSize ||
+	    runtime->dma_bytes < b->u4BufferSize ||
+	    b->u4BufferSize > runtime->hw.buffer_bytes_max ||
+	    b->u4WriteIdx < 0 || b->u4WriteIdx >= b->u4BufferSize ||
+	    b->u4DMAReadIdx < 0 || b->u4DMAReadIdx >= b->u4BufferSize ||
+	    b->u4DataRemained < 0 || b->u4DataRemained > b->u4BufferSize)
+		return false;
+	return true;
+}
+
+static int mtk_pcm_copy_state(struct snd_pcm_runtime *runtime, bool capture)
+{
+	switch (runtime->status->state) {
+	case SNDRV_PCM_STATE_PREPARED:
+	case SNDRV_PCM_STATE_RUNNING:
+	case SNDRV_PCM_STATE_PAUSED:
+		return 0;
+	case SNDRV_PCM_STATE_DRAINING:
+		return capture ? 0 : -EBADFD;
+	case SNDRV_PCM_STATE_SUSPENDED:
+		return -ESTRPIPE;
+	case SNDRV_PCM_STATE_XRUN:
+		return -EPIPE;
+	default:
+		return -EBADFD;
+	}
+}
+
+/*
+ * Linux 4.9 .copy returns status: every nonnegative result accepts ALL frames.
+ * Stage the entire request so user faults cannot publish part of a ring write.
+ * Capture faults may change the user buffer, but do not consume ring bytes.
+ * Only kernel/MMIO copies run under the stream and IRQ ring locks.
+ */
+static int mtk_pcm_transfer(struct snd_pcm_substream *substream,
+		struct AFE_MEM_CONTROL_T *control, unsigned long *generation,
+		int channel, snd_pcm_uframes_t pos, void __user *user,
+		snd_pcm_uframes_t count, bool capture)
+{
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	struct AFE_BLOCK_T *b;
+	unsigned long flags, saved_generation;
+	unsigned int frame_bytes;
+	unsigned char *staging, *ring;
+	int bytes, offset, size, first, err;
+
+	if (!count)
+		return 0;
+	if (!control)
+		return -ENODEV;
+	/* These platforms expose interleaved mono/stereo, not per-channel copies. */
+	frame_bytes = runtime->frame_bits / 8;
+	if (channel != -1 || runtime->channels < 1 || runtime->channels > 2 ||
+	    !frame_bytes || runtime->frame_bits % 8 ||
+	    count > INT_MAX / frame_bytes || pos > INT_MAX / frame_bytes ||
+	    count > runtime->buffer_size || pos >= runtime->buffer_size ||
+	    count > runtime->hw.buffer_bytes_max / frame_bytes)
+		return -EINVAL;
+	bytes = count * frame_bytes;
+	offset = pos * frame_bytes;
+	staging = kmalloc(bytes, GFP_KERNEL);
+	if (!staging)
+		return -ENOMEM;
+	b = &control->rBlock;
+
+	snd_pcm_stream_lock_irqsave(substream, flags);
+	err = mtk_pcm_copy_state(runtime, capture);
+	if (err)
+		goto stream_out;
+	/* Refresh DMA progress without holding the lock taken by .pointer. */
+	if (runtime->status->state == SNDRV_PCM_STATE_RUNNING &&
+	    substream->ops->pointer(substream) == SNDRV_PCM_POS_XRUN) {
+		err = -EPIPE;
+		goto stream_out;
+	}
+	spin_lock(&control->substream_lock);
+	if (!mtk_pcm_ring_valid(runtime, b) ||
+	    offset != (capture ? b->u4DMAReadIdx : b->u4WriteIdx) ||
+	    bytes > (capture ? b->u4DataRemained :
