diff --git a/drivers/misc/mediatek/power/mt8163/asus_p00a/battery_diag.c b/drivers/misc/mediatek/power/mt8163/asus_p00a/battery_diag.c
new file mode 100644
--- /dev/null
+++ b/drivers/misc/mediatek/power/mt8163/asus_p00a/battery_diag.c
@@ -0,0 +1,95 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Main pad battery measurements, independent of the unvalidated SW estimator. */
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/power/asus_p00a_battery.h>
+
+/* ASUS Z380M 10k battery NTC. This is NOT the AUXADC0 board thermistor. */
+static const int p00a_ntc_ohms[] = {
+	75022, 57926, 45168, 35548, 28224, 22595, 18231, 14820,
+	12133, 10000, 8295, 6922, 5810, 4903, 4160, 3547, 3039
+};
+
+static int p00a_battery_temperature(int mv, int *decic)
+{
+	int parallel, resistance, i;
+
+	if (mv <= 0 || mv >= 1800)
+		return -ERANGE;
+	parallel = 16900 * mv / (1800 - mv);
+	if (parallel >= 30000)
+		return -ERANGE;
+	resistance = parallel * 30000 / (30000 - parallel);
+	if (resistance > p00a_ntc_ohms[0] ||
+	    resistance < p00a_ntc_ohms[ARRAY_SIZE(p00a_ntc_ohms) - 1])
+		return -ERANGE;
+	for (i = 1; i < ARRAY_SIZE(p00a_ntc_ohms); i++) {
+		if (resistance >= p00a_ntc_ohms[i]) {
+			*decic = -200 + (i - 1) * 50 +
+				(p00a_ntc_ohms[i - 1] - resistance) * 50 /
+				(p00a_ntc_ohms[i - 1] - p00a_ntc_ohms[i]);
+			return 0;
+		}
+	}
+	return -ERANGE;
+}
+
+int asus_p00a_battery_get_property(enum power_supply_property property,
+				 union power_supply_propval *val)
+{
+	int present, mv, ret;
+
+	switch (property) {
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		return 0;
+	case POWER_SUPPLY_PROP_CAPACITY:
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+	case POWER_SUPPLY_PROP_CURRENT_AVG:
+	case POWER_SUPPLY_PROP_CHARGE_COUNTER:
+	case POWER_SUPPLY_PROP_CHARGE_FULL:
+		return -ENODATA;
+	case POWER_SUPPLY_PROP_PRESENT:
+		return asus_p00a_pmic_present(&val->intval);
+	case POWER_SUPPLY_PROP_STATUS:
+	case POWER_SUPPLY_PROP_HEALTH:
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+	case POWER_SUPPLY_PROP_batt_vol:
+	case POWER_SUPPLY_PROP_TEMP:
+	case POWER_SUPPLY_PROP_batt_temp:
+		break;
+	default:
+		/* Do not leak cached engineering properties as real measurements. */
+		return -ENODATA;
+	}
+	ret = asus_p00a_pmic_present(&present);
+	if (ret)
+		return ret;
+	if (!present)
+		return -ENODATA;
+	switch (property) {
+	case POWER_SUPPLY_PROP_STATUS:
+		return asus_p00a_charger_status(&val->intval);
+	case POWER_SUPPLY_PROP_HEALTH:
+		/* Reading REG0C here would consume the charging guard's fault latch.
+		 * A fitted battery and in-range temperature do not prove good health.
+		 */
+		val->intval = POWER_SUPPLY_HEALTH_UNKNOWN;
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+	case POWER_SUPPLY_PROP_batt_vol:
+		ret = asus_p00a_pmic_adc(6, 5, &mv);
+		if (ret)
+			return ret;
+		if (mv < 2000 || mv > 5000)
+			return -ERANGE;
+		val->intval = mv * 1000;
+		return 0;
+	case POWER_SUPPLY_PROP_TEMP:
+	case POWER_SUPPLY_PROP_batt_temp:
+		ret = asus_p00a_pmic_adc(5, 5, &mv);
+		return ret ? ret : p00a_battery_temperature(mv, &val->intval);
+	default:
+		return -EINVAL;
+	}
+}
diff --git a/drivers/misc/mediatek/power/mt8163/asus_p00a/battery_status.inc b/drivers/misc/mediatek/power/mt8163/asus_p00a/battery_status.inc
new file mode 100644
--- /dev/null
+++ b/drivers/misc/mediatek/power/mt8163/asus_p00a/battery_status.inc
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <linux/power/asus_p00a_battery.h>
+
+int asus_p00a_charger_status(int *status)
+{
+	unsigned int state, control;
+	int ret;
+
+	mutex_lock(&p00a_global_lock);
+	if (!p00a) {
+		ret = -ENODEV;
+		goto out_global;
+	}
+	mutex_lock(&p00a->lock);
+	if (p00a->limits.suspended) {
+		ret = -ENODATA;
+		goto out;
+	}
+	ret = regmap_read(p00a->map, REG_CONTROL, &control);
+	if (ret)
+		goto out;
+	ret = regmap_read(p00a->map, REG_STATUS, &state);
+	if (ret)
+		goto out;
+	if (!(state & BIT(2)))
+		*status = POWER_SUPPLY_STATUS_DISCHARGING;
+	else if (!(control & CHG_ENABLE))
+		*status = POWER_SUPPLY_STATUS_NOT_CHARGING;
+	else {
+		switch ((state >> 3) & 3) {
+		case 1:
+		case 2:
+			*status = POWER_SUPPLY_STATUS_CHARGING;
+			break;
+		case 3:
+			*status = POWER_SUPPLY_STATUS_FULL;
+			break;
+		default:
+			*status = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		}
+	}
+out:
+	mutex_unlock(&p00a->lock);
+out_global:
+	mutex_unlock(&p00a_global_lock);
+	return ret;
+}
