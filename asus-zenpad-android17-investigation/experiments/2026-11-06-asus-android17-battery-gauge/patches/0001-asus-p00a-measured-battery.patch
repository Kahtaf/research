diff --git a/drivers/misc/mediatek/power/mt8163/asus_p00a/pmic_battery.inc b/drivers/misc/mediatek/power/mt8163/asus_p00a/pmic_battery.inc
new file mode 100644
--- /dev/null
+++ b/drivers/misc/mediatek/power/mt8163/asus_p00a/pmic_battery.inc
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included by pmic_mt6323.c to share its ADC serialization and wake source. */
+#include <linux/power/asus_p00a_battery.h>
+
+static int p00a_pmic_result(int ret)
+{
+	return ret > 0 ? -EIO : ret;
+}
+
+/* Bounded version of the MT6323 decimation-delay workaround. */
+static int p00a_pmic_prepare_adc(void)
+{
+	unsigned int delay, busy;
+	unsigned long flags;
+	int ret, poll;
+
+	for (poll = 0; poll < ADC_COUNT_TIMEOUT; poll++) {
+		spin_lock_irqsave(&pmic_adc_lock, flags);
+		ret = p00a_pmic_result(pmic_read_interface_nolock(AUXADC_CON19,
+			&delay, PMIC_RG_ADC_DECI_GDLY_MASK,
+			PMIC_RG_ADC_DECI_GDLY_SHIFT));
+		if (!ret && delay == 1) {
+			ret = p00a_pmic_result(pmic_read_interface_nolock(
+				AUXADC_ADC19, &busy, 0x7fff, 1));
+			if (!ret && !busy)
+				ret = p00a_pmic_result(pmic_config_interface_nolock(
+					AUXADC_CON19, 0, PMIC_RG_ADC_DECI_GDLY_MASK,
+					PMIC_RG_ADC_DECI_GDLY_SHIFT));
+		}
+		spin_unlock_irqrestore(&pmic_adc_lock, flags);
+		if (ret)
+			return ret;
+		if (delay != 1)
+			return 0;
+		usleep_range(1000, 2000);
+	}
+	return -ETIMEDOUT;
+}
+
+int asus_p00a_pmic_present(int *present)
+{
+	unsigned int value;
+	int ret;
+
+	if (!READ_ONCE(pmicAuxadc_irq_lock) || !READ_ONCE(pwrap_regmap))
+		return -ENODATA;
+	ret = p00a_pmic_result(pmic_read_interface(CHR_CON7, &value, 0xffff, 0));
+	if (ret)
+		return ret;
+	/* Do not interpret the detector's reset value as a fitted battery. */
+	if (!(value & BIT(PMIC_RG_BATON_EN_SHIFT)) ||
+	    !(value & BIT(PMIC_BATON_TDET_EN_SHIFT)))
+		return -ENODATA;
+	*present = !(value & BIT(PMIC_RGS_BATON_UNDET_SHIFT));
+	return 0;
+}
+
+int asus_p00a_pmic_adc(unsigned int channel, int samples, int *mv)
+{
+	static const unsigned int output_reg[] = {
+		AUXADC_ADC2, AUXADC_ADC3, AUXADC_ADC1, AUXADC_ADC0
+	};
+	unsigned int raw, sum = 0;
+	int ret, sample, poll;
+
+	if (channel < 4 || channel > 7 || samples < 1 || samples > 32)
+		return -EINVAL;
+	if (!READ_ONCE(pmicAuxadc_irq_lock) || !READ_ONCE(pwrap_regmap))
+		return -ENODATA;
+
+	__pm_stay_awake(pmicAuxadc_irq_lock);
+	mutex_lock(&pmic_adc_mutex);
+	ret = p00a_pmic_prepare_adc();
+	if (ret)
+		goto out;
+	ret = p00a_pmic_result(pmic_config_interface(AUXADC_CON11, 1,
+			PMIC_RG_VBUF_EN_MASK, PMIC_RG_VBUF_EN_SHIFT));
+	if (ret)
+		goto out;
+	for (sample = 0; sample < samples; sample++) {
+		ret = p00a_pmic_result(pmic_config_interface(AUXADC_CON22,
+				0, 1, channel));
+		if (ret)
+			goto out;
+		ret = p00a_pmic_result(pmic_config_interface(AUXADC_CON22,
+				1, 1, channel));
+		if (ret)
+			goto out;
+		udelay(300);
+		for (poll = 0; poll < ADC_COUNT_TIMEOUT; poll++) {
+			ret = p00a_pmic_result(pmic_read_interface(
+				output_reg[channel - 4], &raw, 0xffff, 0));
+			if (ret)
+				goto out;
+			if (raw & BIT(15))
+				break;
+			usleep_range(1000, 2000);
+		}
+		if (poll == ADC_COUNT_TIMEOUT) {
+			ret = -ETIMEDOUT;
+			goto out;
+		}
+		sum += raw & 0x7fff;
+	}
+	/* MT6323 channels 6/7 have a hardware 4:1 voltage divider. */
+	*mv = (sum / samples) * (channel >= 6 ? 4 : 1) * 1800 / 32768;
+	ret = 0;
+out:
+	mutex_unlock(&pmic_adc_mutex);
+	__pm_relax(pmicAuxadc_irq_lock);
+	return ret;
+}
