--- /dev/null
+++ b/include/linux/asus_retained_trace.h
@@ -0,0 +1,18 @@
+/* Diagnostic interface; disabled builds compile all calls away. */
+#ifndef _LINUX_ASUS_RETAINED_TRACE_H
+#define _LINUX_ASUS_RETAINED_TRACE_H
+#include <linux/init.h>
+#include <linux/types.h>
+#include <linux/string.h>
+#ifdef CONFIG_ASUS_P00A_RETAINED_BOOT_TRACE
+void __init asus_retained_trace_init(void);
+void asus_retained_trace_write(const char *text, unsigned int len);
+#else
+static inline void asus_retained_trace_init(void) { }
+static inline void asus_retained_trace_write(const char *text, unsigned int len) { }
+#endif
+static inline void asus_retained_trace_mark(const char *text)
+{
+	asus_retained_trace_write(text, strlen(text));
+}
+#endif
--- /dev/null
+++ b/arch/arm64/kernel/asus_retained_trace.c
@@ -0,0 +1,176 @@
+/* GPL-2.0: diagnostic writer for the shipped ASUS P00A 3.18 ram_console ABI. */
+#include <linux/asus_retained_trace.h>
+#include <linux/initrd.h>
+#include <linux/kernel.h>
+#include <linux/memblock.h>
+#include <linux/of.h>
+#include <linux/of_fdt.h>
+#include <linux/spinlock.h>
+#include <asm/cacheflush.h>
+#include <asm/memory.h>
+#include <asm/sections.h>
+
+#define TRACE_BASE 0x44400000ULL
+#define TRACE_SIZE 0x80000U
+#define TRACE_SIG  0x43474244U
+#define TRACE_RR_SIZE 0x400U
+
+struct trace_header {
+	u32 sig, off_pl, off_lpl, sz_pl, off_lk, off_llk, sz_lk;
+	u32 padding[3];
+	u32 sz_buffer, off_linux, off_console, log_start, log_size, sz_console;
+};
+
+static struct trace_header *trace;
+static DEFINE_RAW_SPINLOCK(trace_lock);
+
+static bool __init trace_overlaps(u64 base, u64 size)
+{
+	return size && base < TRACE_BASE + TRACE_SIZE &&
+		(size > U64_MAX - base || base + size > TRACE_BASE);
+}
+
+struct trace_dt_check {
+	bool in_reserved, bad;
+	unsigned int matches;
+};
+
+static int __init trace_check_dt(unsigned long node, const char *name,
+				 int depth, void *arg)
+{
+	struct trace_dt_check *check = arg;
+	const __be32 *reg, *prop;
+	const char *status;
+	int len, status_len, i;
+
+	if (depth == 1) {
+		check->in_reserved = !strcmp(name, "reserved-memory");
+		if (check->in_reserved) {
+			prop = of_get_flat_dt_prop(node, "#address-cells", &len);
+			if (!prop || len != 4 || be32_to_cpup(prop) != 2)
+				check->bad = true;
+			prop = of_get_flat_dt_prop(node, "#size-cells", &len);
+			if (!prop || len != 4 || be32_to_cpup(prop) != 2)
+				check->bad = true;
+			prop = of_get_flat_dt_prop(node, "ranges", &len);
+			if (!prop || len != 0)
+				check->bad = true;
+		}
+	}
+	if (!check->in_reserved || depth != 2)
+		return 0;
+	reg = of_get_flat_dt_prop(node, "reg", &len);
+	if (!reg)
+		return 0; /* Dynamic reservations already went through memblock. */
+	if (len <= 0 || len % 16) {
+		check->bad = true;
+		return 0;
+	}
+	for (i = 0; i < len / 4; i += 4) {
+		u64 base = of_read_number(reg + i, 2);
+		u64 size = of_read_number(reg + i + 2, 2);
+
+		if (!trace_overlaps(base, size))
+			continue;
+		if (base != TRACE_BASE || size != TRACE_SIZE || len != 16 ||
+		    !of_flat_dt_is_compatible(node, "mediatek,ram_console") ||
+		    of_get_flat_dt_prop(node, "no-map", NULL) ||
+		    of_get_flat_dt_prop(node, "reusable", NULL))
+			check->bad = true;
+		status = of_get_flat_dt_prop(node, "status", &status_len);
+		if (status && !((status_len == 3 && !memcmp(status, "ok", 3)) ||
+				(status_len == 5 && !memcmp(status, "okay", 5))))
+			check->bad = true;
+		check->matches++;
+	}
+	return 0;
+}
+
+/* Keep the first text; a full buffer freezes instead of losing entry markers. */
+void asus_retained_trace_write(const char *text, unsigned int len)
+{
+	struct trace_header *h = READ_ONCE(trace);
+	unsigned long flags;
+	u32 pos, count;
+	char *dest;
+
+	if (!h || !len || !raw_spin_trylock_irqsave(&trace_lock, flags))
+		return;
+	pos = h->log_size;
+	if (pos >= h->sz_console)
+		goto out;
+	count = min(len, h->sz_console - pos);
+	dest = (char *)h + h->off_console + pos;
+	memcpy(dest, text, count);
+	pos += count;
+	if (pos < h->sz_console && text[count - 1] != '\n') {
+		dest[count++] = '\n';
+		pos++;
+	}
+	/* log_start stays zero: the OEM reader then emits [0, log_size). */
+	/* Complete payload stores to PoC before the single aligned size commit. */
+	__clean_dcache_area_poc(dest, count);
+	WRITE_ONCE(h->log_size, pos);
+	__clean_dcache_area_poc(h, sizeof(*h));
+out:
+	raw_spin_unlock_irqrestore(&trace_lock, flags);
+}
+
+void __init asus_retained_trace_init(void)
+{
+	struct trace_dt_check check = { };
+	struct trace_header *h;
+	u64 linux_off, pl_end, lk_end;
+	phys_addr_t page;
+	extern phys_addr_t __fdt_pointer;
+
+	BUILD_BUG_ON(sizeof(struct trace_header) != 64);
+	BUILD_BUG_ON(offsetof(struct trace_header, off_linux) != 0x2c);
+	BUILD_BUG_ON(offsetof(struct trace_header, off_console) != 0x30);
+	BUILD_BUG_ON(offsetof(struct trace_header, log_start) != 0x34);
+	BUILD_BUG_ON(offsetof(struct trace_header, log_size) != 0x38);
+	BUILD_BUG_ON(offsetof(struct trace_header, sz_console) != 0x3c);
+	if (!of_flat_dt_is_compatible(of_get_flat_dt_root(), "asus,p00a"))
+		return;
+	of_scan_flat_dt(trace_check_dt, &check);
+	if (check.bad || check.matches != 1 ||
+	    !memblock_is_region_memory(TRACE_BASE, TRACE_SIZE) ||
+	    trace_overlaps(__pa_symbol(_text), _end - _text) ||
+	    trace_overlaps(__fdt_pointer, of_get_flat_dt_size()))
+		goto refuse;
+	if (initrd_start && trace_overlaps(__pa(initrd_start),
+					 initrd_end - initrd_start))
+		goto refuse;
+	for (page = TRACE_BASE; page < TRACE_BASE + TRACE_SIZE; page += PAGE_SIZE)
+		if (!memblock_is_map_memory(page) || !memblock_is_reserved(page))
+			goto refuse;
+
+	/* paging_init has made the sole normal-cacheable linear mapping usable. */
+	h = __va(TRACE_BASE);
+	pl_end = (u64)h->off_pl + ALIGN((u64)h->sz_pl, 64);
+	lk_end = (u64)h->off_lk + ALIGN((u64)h->sz_lk, 64);
+	linux_off = h->sz_lk ? lk_end + ALIGN((u64)h->sz_lk, 64) : 512;
+	if (h->sig != TRACE_SIG || h->sz_buffer != TRACE_SIZE ||
+	    pl_end != h->off_lpl || lk_end != h->off_llk ||
+	    lk_end > linux_off ||
+	    linux_off < 512 || linux_off > TRACE_SIZE - TRACE_RR_SIZE ||
+	    (u64)h->off_lpl + ALIGN((u64)h->sz_pl, 64) > linux_off ||
+	    h->off_linux != linux_off ||
+	    h->off_console != linux_off + TRACE_RR_SIZE ||
+	    h->sz_console != TRACE_SIZE - h->off_console || !h->sz_console ||
+	    h->log_size > h->sz_console || h->log_start > h->log_size)
+		goto refuse;
+
+	/* Preserve PL/LK headers and payloads. Only reset Linux reason and text. */
+	h->log_start = 0;
+	__clean_dcache_area_poc(h, sizeof(*h));
+	h->log_size = 0;
+	__clean_dcache_area_poc(h, sizeof(*h));
+	memset((char *)h + h->off_linux, 0, TRACE_RR_SIZE);
+	__clean_dcache_area_poc((char *)h + h->off_linux, TRACE_RR_SIZE);
+	WRITE_ONCE(trace, h);
+	asus_retained_trace_mark("ASUS-e9-retained-v1 01 paging_init returned; trace ready");
+	return;
+refuse:
+	pr_warn("ASUS retained trace refused: unexpected DT, memory or OEM header\n");
+}
