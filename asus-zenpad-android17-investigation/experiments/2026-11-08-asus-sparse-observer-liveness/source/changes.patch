+/* Sparse admission only; accepted writes retain the original publication path. */
+static bool sparse_prefix(const char *p, unsigned int n,
+                          const char *s, unsigned int k)
+{
+ return n >= k && !memcmp(p, s, k);
+}
+
+static bool sparse_equal(const char *p, unsigned int n,
+                         const char *s, unsigned int k)
+{
+ return n == k && !memcmp(p, s, k);
+}
+
+static bool sparse_admit(const char *text, unsigned int len)
+{
+ unsigned int i;
+ static const char helper[] = "ASUS49-SYSCLOCK run=f0c3c82c-d639-4d8a-90f2-155fd4224ceb";
+ if (!len || len > 767)
+  return false;
+ if (text[len - 1] == '\n')
+  --len;
+ for (i = 0; i < len; ++i)
+  if ((unsigned char)text[i] < 32 || (unsigned char)text[i] > 126)
+   return false;
+#define SAME(s) sparse_equal(text, len, s, sizeof(s) - 1)
+ if (SAME(ASUS_SPARSE_MODE) || SAME("ASUS-e9-retained-v2 00 arm64_memblock_init returned; before paging_init") ||
+     SAME("ASUS-e9-retained-v2 01 paging_init returned; trace ready") ||
+     SAME("02 setup_arch returned") ||
+     SAME("03 before init_IRQ") ||
+     SAME("04 init_IRQ returned") ||
+     SAME("05 before time_init") ||
+     SAME("06 time_init returned"))
+  return true;
+#undef SAME
+ if (!sparse_prefix(text, len, helper, sizeof(helper) - 1))
+  return false;
+ text += sizeof(helper) - 1;
+ len -= sizeof(helper) - 1;
+#define PREFIX(s) sparse_prefix(text, len, s, sizeof(s) - 1)
+ return PREFIX(" phase=setup stage=actual op=getpid path=- rc=") ||
+        PREFIX(" phase=setup stage=actual op=uname.release path=- rc=") ||
+        PREFIX(" phase=observe stage=actual op=clock.path path=CLOCK_MONOTONIC rc=") ||
+        PREFIX(" phase=observe stage=begin op=clock_gettime path=loop.initial rc=") ||
+        PREFIX(" phase=observe stage=end op=clock_gettime path=loop.initial rc=") ||
+        PREFIX(" phase=observe stage=begin op=alarm.nominal1s.timer-dependent path=- rc=") ||
+        PREFIX(" phase=observe stage=end op=alarm.nominal1s.timer-dependent path=- rc=") ||
+        PREFIX(" phase=observe stage=actual op=clock_gettime.final path=CLOCK_MONOTONIC rc=") ||
+        PREFIX(" phase=observe stage=complete op=runnable.loop path=CLOCK_MONOTONIC rc=") ||
+        PREFIX(" phase=before stage=actual op=interrupts.arch_timer path=/proc/interrupts rc=") ||
+        PREFIX(" phase=before stage=complete op=interrupts.snapshot path=/proc/interrupts rc=") ||
+        PREFIX(" phase=after stage=actual op=interrupts.arch_timer path=/proc/interrupts rc=") ||
+        PREFIX(" phase=after stage=complete op=interrupts.snapshot path=/proc/interrupts rc=") ||
+        PREFIX(" phase=finish stage=actual op=alarm.final-flag path=SIGALRM rc=") ||
+        PREFIX(" phase=finish stage=complete op=observation path=- rc=") ||
+        PREFIX(" phase=finish stage=actual op=sink.write.error path=- rc=") ||
+        PREFIX(" phase=finish stage=begin op=reboot path=- rc=") ||
+        PREFIX(" phase=finish stage=end op=reboot path=- rc=") ||
+        sparse_equal(text, len, " stage=alarm op=SIGALRM.fired nominal_seconds=1 timer_dependent=1", sizeof(" stage=alarm op=SIGALRM.fired nominal_seconds=1 timer_dependent=1") - 1);
+#undef PREFIX
+}
