+
+/* Bounded read of an already published old PS snapshot. No old lock, owner
+ * variable, driver pointer dereference, or changes to an old writer/layout.
+ * Runtime UP and this writer's short IRQ mask exclude old publications here.
+ */
+static bool pm_ps_field(const char *row, unsigned int field, u64 *value)
+{
+ unsigned int i, digit;
+ char ch;
+ *value = 0;
+ for (i = 0; i < 16; ++i) {
+  ch = row[9 + field * 17 + i];
+  if (ch >= '0' && ch <= '9')
+   digit = ch - '0';
+  else if (ch >= 'a' && ch <= 'f')
+   digit = ch - 'a' + 10;
+  else
+   return false;
+  *value = (*value << 4) | digit;
+ }
+ return true;
+}
+
+static void pm_property(struct asus_pmic_capture *c)
+{
+ const char *row;
+ u64 f[20];
+ unsigned int i;
+ if (!smp_load_acquire(&ps_area) || !in_task())
+  return;
+ row = ps_storage + PS_ROW_OFFSET + (PS_RING + 1) * PS_ROW_SIZE;
+ if (row[0] != 'V')
+  return;
+ for (i = 0; i < ARRAY_SIZE(f); ++i)
+  if (!pm_ps_field(row, i, &f[i]))
+   return;
+ if (f[2] != 40 || f[4] != (u32)current->pid || !(f[10] & 4) ||
+     !f[1] || f[0] != f[1] || f[16] != f[1] || f[0] > ps_total)
+  return;
+ c->property_token = f[1];
+ c->property_seq = f[0];
+ c->property_raw = f[3];
+ c->body_token = f[14];
+ c->body_phase = f[17];
+ c->work = f[5];
+ c->psy = f[6];
+ c->callback = f[7];
+ c->property = f[8];
+}
