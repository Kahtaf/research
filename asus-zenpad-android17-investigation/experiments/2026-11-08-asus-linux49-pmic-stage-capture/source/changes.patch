+/* Independent, nonblocking publication; never held across an original primitive. */
+#define PM_RING 6
+#define PM_ROW_SIZE 576
+#define PM_ROW_OFFSET 384
+#define PM_ROWS (PM_RING + 4)
+#define PM_SIZE (PM_ROW_OFFSET + PM_ROWS * PM_ROW_SIZE + 64)
+static char *pm_area, *pm_storage;
+static u64 pm_total;
+static DEFINE_RAW_SPINLOCK(pm_lock);
+static const char pm_guard_a[] = "A49MGUARD BEGIN a1ff82b1-3e45-4f05-8c99-7112204d3981           \n";
+static const char pm_guard_z[] = "A49MGUARD END   a1ff82b1-3e45-4f05-8c99-7112204d3981           \n";
+
+static void pm_fault(unsigned int offset)
+{
+ char *area = READ_ONCE(pm_area);
+ if (!area)
+  return;
+ WRITE_ONCE(area[256 + 9], '1');
+ WRITE_ONCE(area[256 + offset], '1');
+ __clean_dcache_area_poc(area + 256, 64);
+}
+
+static void pm_header(void)
+{
+ char line[192];
+ u64 f[] = {pm_total + 1, pm_total,
+  pm_total > PM_RING ? pm_total - PM_RING + 1 : !!pm_total,
+  pm_total, pm_total ? (pm_total - 1) / PM_RING : 0,
+  min_t(u64, pm_total, PM_RING), 0, nr_cpu_ids};
+ unsigned int i;
+ memset(line, ' ', sizeof(line));
+ memcpy(line, "!A49MH ", 7);
+ for (i = 0; i < ARRAY_SIZE(f); ++i)
+  cap_hex(line + 9 + i * 17, f[i], 16);
+ cap_hex(line + 160, f[0], 16);
+ line[191] = '\n';
+ sw_commit(pm_storage + 64, line, sizeof(line));
+}
+
+static void __init pm_init(char *dest)
+{
+ unsigned int i, j;
+ char line[PM_ROW_SIZE];
+ BUILD_BUG_ON(PM_SIZE != 6208);
+ memset(dest, ' ', PM_SIZE);
+ memcpy(dest, "A49PM1 uuid=a1ff82b1-3e45-4f05-8c99-7112204d3981", 48);
+ dest[63] = '\n';
+ memcpy(dest + 256, "A49MLOSS 0 guard=0 busy=0 admission=0 overflow=0", 48);
+ dest[319] = '\n';
+ memcpy(dest + 320, pm_guard_a, sizeof(pm_guard_a) - 1);
+ dest[383] = '\n';
+ memcpy(dest + PM_SIZE - 64, pm_guard_z, sizeof(pm_guard_z) - 1);
+ dest[PM_SIZE - 1] = '\n';
+ pm_storage = dest;
+ for (i = 0; i < PM_ROWS; ++i) {
+  memset(line, ' ', sizeof(line));
+  memcpy(line, "!A49M ", 6);
+  cap_hex(line + 6, i, 2);
+  for (j = 0; j < 29; ++j)
+   cap_hex(line + 9 + j * 17, 0, 16);
+  cap_hex(line + 552, 0, 16);
+  line[PM_ROW_SIZE - 1] = '\n';
+  sw_commit(dest + PM_ROW_OFFSET + i * PM_ROW_SIZE, line, sizeof(line));
+ }
+ pm_header();
+ __clean_dcache_area_poc(dest, PM_SIZE);
