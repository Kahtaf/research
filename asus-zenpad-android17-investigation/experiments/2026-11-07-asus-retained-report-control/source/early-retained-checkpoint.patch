--- a/arch/arm64/kernel/asus_retained_trace.c
+++ b/arch/arm64/kernel/asus_retained_trace.c
@@ -1,12 +1,15 @@
 /* GPL-2.0: diagnostic writer for the shipped ASUS P00A 3.18 ram_console ABI. */
 #include <linux/asus_retained_trace.h>
 #include <linux/initrd.h>
+#include <linux/io.h>
+#include <linux/sizes.h>
 #include <linux/kernel.h>
 #include <linux/memblock.h>
 #include <linux/of.h>
 #include <linux/of_fdt.h>
 #include <linux/spinlock.h>
 #include <asm/cacheflush.h>
+#include <asm/early_ioremap.h>
 #include <asm/memory.h>
 #include <asm/sections.h>
 
@@ -21,6 +24,13 @@
 	u32 sz_buffer, off_linux, off_console, log_start, log_size, sz_console;
 };
 
+/* One fixmap slot is at most 256 KiB on this tree. Never map the full ring
+ * before paging. Only the guarded Linux reason area and entry text are touched.
+ */
+#define EARLY_MAP_SIZE SZ_256K
+static const char early_marker[] =
+	"ASUS-e9-retained-v2 00 arm64_memblock_init returned; before paging_init\n";
+static bool early_committed __initdata;
 static struct trace_header *trace;
 static DEFINE_RAW_SPINLOCK(trace_lock);
 
@@ -116,7 +126,7 @@
 	raw_spin_unlock_irqrestore(&trace_lock, flags);
 }
 
-void __init asus_retained_trace_init(void)
+static void __init trace_init(bool early)
 {
 	struct trace_dt_check check = { };
 	struct trace_header *h;
@@ -145,8 +155,12 @@
 		if (!memblock_is_map_memory(page) || !memblock_is_reserved(page))
 			goto refuse;
 
-	/* paging_init has made the sole normal-cacheable linear mapping usable. */
-	h = __va(TRACE_BASE);
+	/* Match PAGE_KERNEL normal-cacheable attributes; never use early_ioremap's
+	 * Device alias. The temporary mapping is removed before paging_init.
+	 */
+	h = early ? early_memremap(TRACE_BASE, EARLY_MAP_SIZE) : __va(TRACE_BASE);
+	if (!h)
+		goto refuse;
 	pl_end = (u64)h->off_pl + ALIGN((u64)h->sz_pl, 64);
 	lk_end = (u64)h->off_lk + ALIGN((u64)h->sz_lk, 64);
 	linux_off = h->sz_lk ? lk_end + ALIGN((u64)h->sz_lk, 64) : 512;
@@ -159,18 +173,53 @@
 	    h->off_console != linux_off + TRACE_RR_SIZE ||
 	    h->sz_console != TRACE_SIZE - h->off_console || !h->sz_console ||
 	    h->log_size > h->sz_console || h->log_start > h->log_size)
-		goto refuse;
-
-	/* Preserve PL/LK headers and payloads. Only reset Linux reason and text. */
-	h->log_start = 0;
-	__clean_dcache_area_poc(h, sizeof(*h));
-	h->log_size = 0;
-	__clean_dcache_area_poc(h, sizeof(*h));
-	memset((char *)h + h->off_linux, 0, TRACE_RR_SIZE);
-	__clean_dcache_area_poc((char *)h + h->off_linux, TRACE_RR_SIZE);
+		goto unmap;
+
+	/* Additional early-map bounds do not weaken any OEM/DT/memblock guard.
+	 * Layouts outside this window retain the original post-paging path.
+	 */
+	if (early && (h->off_linux > EARLY_MAP_SIZE - TRACE_RR_SIZE ||
+		      h->off_console > EARLY_MAP_SIZE - (sizeof(early_marker) - 1)))
+		goto unmap;
+	if (!early && early_committed &&
+	    (h->log_start || h->log_size != sizeof(early_marker) - 1 ||
+	     memcmp((char *)h + h->off_console, early_marker,
+		    sizeof(early_marker) - 1)))
+		goto unmap;
+
+	/* Preserve PL/LK headers and payloads. Preserve the committed early text
+	 * when switching from the temporary fixmap to the linear mapping.
+	 */
+	if (!early_committed) {
+		h->log_start = 0;
+		__clean_dcache_area_poc(h, sizeof(*h));
+		h->log_size = 0;
+		__clean_dcache_area_poc(h, sizeof(*h));
+		memset((char *)h + h->off_linux, 0, TRACE_RR_SIZE);
+		__clean_dcache_area_poc((char *)h + h->off_linux, TRACE_RR_SIZE);
+	}
 	WRITE_ONCE(trace, h);
-	asus_retained_trace_mark("ASUS-e9-retained-v1 01 paging_init returned; trace ready");
+	if (early) {
+		asus_retained_trace_write(early_marker, sizeof(early_marker) - 1);
+		early_committed = h->log_size == sizeof(early_marker) - 1;
+		WRITE_ONCE(trace, NULL);
+	} else {
+		asus_retained_trace_mark("ASUS-e9-retained-v2 01 paging_init returned; trace ready");
+	}
+unmap:
+	if (early)
+		early_memunmap(h, EARLY_MAP_SIZE);
 	return;
 refuse:
 	pr_warn("ASUS retained trace refused: unexpected DT, memory or OEM header\n");
 }
+
+void __init asus_retained_trace_early_init(void)
+{
+	trace_init(true);
+}
+
+void __init asus_retained_trace_init(void)
+{
+	trace_init(false);
+}
