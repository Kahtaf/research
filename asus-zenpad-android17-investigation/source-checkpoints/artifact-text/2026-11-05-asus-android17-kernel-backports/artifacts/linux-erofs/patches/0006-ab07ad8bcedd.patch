From ab07ad8bcedd34d30669f2866f916d07a60623c2 Mon Sep 17 00:00:00 2001
From: Tim Zimmermann <ACCOUNT_REDACTED>
Date: Sun, 2 Oct 2022 06:00:30 +0200
Subject: [PATCH] fs: erofs: Make armv8 lz4 acceleration Kconfig option more
 descriptive

Change-Id: I7fe536648d4142b7deeb65568177cbbd642bbfd2
(cherry picked from commit 62c99b58652b3d6eee00d00ed1474c447b1d1b19)
---
 fs/erofs/Kconfig        | 8 ++++----
 fs/erofs/decompressor.c | 4 ++--
 fs/erofs/super.c        | 2 +-
 3 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/fs/erofs/Kconfig b/fs/erofs/Kconfig
index bb857d0b85..c474ccc1bb 100644
--- a/fs/erofs/Kconfig
+++ b/fs/erofs/Kconfig
@@ -89,9 +89,9 @@ config EROFS_FS_CLUSTER_PAGE_LIMIT
 	  less than 2. Otherwise, the image will be refused
 	  to mount on this kernel.
 
-config OPLUS_FEATURE_EROFS
-	bool "EROFS oplus repo"
+config EROFS_FS_ARMV8_ACCELERATED_LZ4
+	bool "EROFS LZ4 Acceleration for ARMv8"
 	default y
-	depends on EROFS_FS
+	depends on EROFS_FS && ARM64
 	help
-	  define this config to switch oplus repo.
+	  LZ4 decompression optimization based on arm64 NEON instruction
diff --git a/fs/erofs/decompressor.c b/fs/erofs/decompressor.c
index 72f06e0a75..874f10db52 100755
--- a/fs/erofs/decompressor.c
+++ b/fs/erofs/decompressor.c
@@ -14,7 +14,7 @@
 
 #define LZ4_MAX_DISTANCE_PAGES	(DIV_ROUND_UP(LZ4_DISTANCE_MAX, PAGE_SIZE) + 1)
 #ifndef LZ4_DECOMPRESS_INPLACE_MARGIN
-#ifdef CONFIG_OPLUS_FEATURE_EROFS
+#ifdef CONFIG_EROFS_FS_ARMV8_ACCELERATED_LZ4
 #define LZ4_DECOMPRESS_INPLACE_MARGIN(srcsize)  (((srcsize) >> 8) + 65)
 #else
 #define LZ4_DECOMPRESS_INPLACE_MARGIN(srcsize)  (((srcsize) >> 8) + 32)
@@ -163,7 +163,7 @@ static int z_erofs_lz4_decompress(struct z_erofs_decompress_req *rq, u8 *out)
 			copied = true;
 		}
 	}
-#ifdef CONFIG_OPLUS_FEATURE_EROFS
+#ifdef CONFIG_EROFS_FS_ARMV8_ACCELERATED_LZ4
 	ret = z_erofs_lz4_decompress_partial(src + inputmargin, out,
 					inlen, rq->outputsize,
 					test_opt(EROFS_SB(rq->sb), LZ4ASM),
diff --git a/fs/erofs/super.c b/fs/erofs/super.c
index 0a00f45067..f933bde54e 100644
--- a/fs/erofs/super.c
+++ b/fs/erofs/super.c
@@ -214,7 +214,7 @@ static void erofs_default_options(struct erofs_sb_info *sbi)
 #ifdef CONFIG_EROFS_FS_POSIX_ACL
 	set_opt(sbi, POSIX_ACL);
 #endif
-#ifdef CONFIG_OPLUS_FEATURE_EROFS
+#ifdef CONFIG_EROFS_FS_ARMV8_ACCELERATED_LZ4
 	set_opt(sbi, LZ4ASM);
 #endif
 }
-- 
2.43.0

