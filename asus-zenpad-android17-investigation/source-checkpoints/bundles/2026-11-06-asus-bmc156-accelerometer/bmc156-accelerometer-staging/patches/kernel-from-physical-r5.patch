+	struct i2c_msg msgs[2] = {
+		{
+			.addr = client->addr,	.flags = 0,
+			.len = 1,		.buf = &beg
+		},
+		{
+			.addr = client->addr,	.flags = I2C_M_RD,
+			.len = len,		.buf = data,
+		}
+	};
+	int err;
+
+	if (!client)
+		return -EINVAL;
+/*
+	else if (len > C_I2C_FIFO_SIZE) {
+		GSE_ERR(" length %d exceeds %d\n", len, C_I2C_FIFO_SIZE);
+		return -EINVAL;
+	}
+*/
+
+	mutex_lock(&i2c_lock);
+	err = i2c_transfer(client->adapter, msgs, sizeof(msgs)/sizeof(msgs[0]));
+	mutex_unlock(&i2c_lock);
+	if (err != 2) {
+		GSE_ERR("i2c_transfer error: (%d %p %d) %d\n",
+			addr, data, len, err);
+		err = -EIO;
+	} else {
+		err = 0;/*no error*/
+	}
+
+	return err;
+}
+static int bma_i2c_write_block(struct i2c_client *client, u8 addr,
+			u8 *data, u8 len)
+{
+	/*
+	*because address also occupies one byte,
+	*the maximum length for write is 7 bytes
+	*/
+	int err, idx = 0, num = 0;
+	char buf[32];
+
+	if (!client || len > 31)
+		return -EINVAL;
+/*
+	else if (len > C_I2C_FIFO_SIZE) {
+		GSE_ERR(" length %d exceeds %d\n", len, C_I2C_FIFO_SIZE);
+		return -EINVAL;
+	}
+*/
+
+	buf[num++] = addr;
+	for (idx = 0; idx < len; idx++)
+		buf[num++] = data[idx];
+
+	mutex_lock(&i2c_lock);
+	err = i2c_master_send(client, buf, num);
+	mutex_unlock(&i2c_lock);
+	if (err != num) {
+		GSE_ERR("send command error!!\n");
+		return -EFAULT;
+	}
+	err = 0;/*no error*/
+	return err;
+}
+static int BMA255_SetDataResolution(struct bma255_i2c_data *obj)
+{
+ obj->reso = &bma255_data_resolution[0];
+ return 0;
+}
+static int BMA255_ReadData(struct i2c_client *client, s16 data[BMA255_AXES_NUM])
+{
+	u8 addr = BMA255_REG_DATAXLOW;
+	u8 buf[BMA255_DATA_LEN] = {0};
+	int err = 0;
+
+	if (NULL == client)
+		return -EINVAL;
+
+	err = bma_i2c_read_block(client, addr, buf, BMA255_DATA_LEN);
+	if (err) {
+		GSE_ERR("error: %d\n", err);
+	}  else {
+		/* Convert sensor raw data to 16-bit integer */
+		data[BMA255_AXIS_X] = BMA255_GET_BITSLICE(buf[0], BMA255_ACC_X_LSB)
+			|(BMA255_GET_BITSLICE(buf[1],
+						BMA255_ACC_X_MSB)<<BMA255_ACC_X_LSB__LEN);
+		data[BMA255_AXIS_X] = data[BMA255_AXIS_X] << (sizeof(short)*8-(BMA255_ACC_X_LSB__LEN
+					+ BMA255_ACC_X_MSB__LEN));
+		data[BMA255_AXIS_X] = data[BMA255_AXIS_X] >> (sizeof(short)*8-(BMA255_ACC_X_LSB__LEN
+					+ BMA255_ACC_X_MSB__LEN));
+		data[BMA255_AXIS_Y] = BMA255_GET_BITSLICE(buf[2], BMA255_ACC_Y_LSB)
+			| (BMA255_GET_BITSLICE(buf[3],
+						BMA255_ACC_Y_MSB)<<BMA255_ACC_Y_LSB__LEN);
+		data[BMA255_AXIS_Y] = data[BMA255_AXIS_Y] << (sizeof(short)*8-(BMA255_ACC_Y_LSB__LEN
+					+ BMA255_ACC_Y_MSB__LEN));
+		data[BMA255_AXIS_Y] = data[BMA255_AXIS_Y] >> (sizeof(short)*8-(BMA255_ACC_Y_LSB__LEN
+					+ BMA255_ACC_Y_MSB__LEN));
+		data[BMA255_AXIS_Z] = BMA255_GET_BITSLICE(buf[4], BMA255_ACC_Z_LSB)
+			| (BMA255_GET_BITSLICE(buf[5],
+						BMA255_ACC_Z_MSB)<<BMA255_ACC_Z_LSB__LEN);
+		data[BMA255_AXIS_Z] = data[BMA255_AXIS_Z] << (sizeof(short)*8-(BMA255_ACC_Z_LSB__LEN
+					+ BMA255_ACC_Z_MSB__LEN));
+		data[BMA255_AXIS_Z] = data[BMA255_AXIS_Z] >> (sizeof(short)*8-(BMA255_ACC_Z_LSB__LEN
+					+ BMA255_ACC_Z_MSB__LEN));
+
+
+	}
+	return err;
+}
+static int BMA255_CheckDeviceID(struct i2c_client *client)
+{
+	u8 databuf[2];
+	int res = 0;
+
+	memset(databuf, 0, sizeof(u8)*2);
+
+	res = bma_i2c_read_block(client, BMA255_REG_DEVID, databuf, 0x01);
+	if (res < 0)
+		goto exit_BMA255_CheckDeviceID;
+
+	if (databuf[0] != BMA255_FIXED_DEVID) {
+		GSE_ERR("BMA255_CheckDeviceID %d failt!\n ", databuf[0]);
+		return BMA255_ERR_IDENTIFICATION;
+	}
+	GSE_LOG("BMA255_CheckDeviceID %d pass!\n ", databuf[0]);
+
+exit_BMA255_CheckDeviceID:
+	if (res < 0)
+		return BMA255_ERR_I2C;
+
+	return BMA255_SUCCESS;
+}
+static int BMA255_SetPowerMode(struct i2c_client *client, bool enable)
+{
+	u8 databuf[2] = {0};
+	int res = 0;
+	/*u8 addr = BMA255_REG_POWER_CTL;*/
+	struct bma255_i2c_data *obj = i2c_get_clientdata(client);
+	u8 actual_power_mode = 0;
+
+	if (sensor_power_valid && enable == sensor_power) {
+		GSE_LOG("Sensor power status is newest!\n");
+		return BMA255_SUCCESS;
+	}
+
+	mutex_lock(&obj->lock);
+	if (enable == true)
+		actual_power_mode = BMA255_MODE_NORMAL;
+	else
+		actual_power_mode = BMA255_MODE_SUSPEND;
+
+	res = bma_i2c_read_block(client,
+			BMA255_MODE_CTRL_REG, &databuf[0], 1);
+	if (!res)
+		res = bma_i2c_read_block(client,
+			BMA255_LOW_POWER_CTRL_REG, &databuf[1], 1);
+	if (res) {
+		mutex_unlock(&obj->lock);
+		return res;
+	}
+
+	switch (actual_power_mode) {
+	case BMA255_MODE_NORMAL:
+		databuf[0] = BMA255_SET_BITSLICE(databuf[0],
+			BMA255_MODE_CTRL, 0);
+		databuf[1] = BMA255_SET_BITSLICE(databuf[1],
+			BMA255_LOW_POWER_MODE, 0);
+		res += bma_i2c_write_block(client,
+			BMA255_MODE_CTRL_REG, &databuf[0], 1);
+		mdelay(1);
+		res += bma_i2c_write_block(client,
+			BMA255_LOW_POWER_CTRL_REG, &databuf[1], 1);
+		mdelay(1);
+	break;
+	case BMA255_MODE_SUSPEND:
+		databuf[0] = BMA255_SET_BITSLICE(databuf[0],
+			BMA255_MODE_CTRL, 4);
+		databuf[1] = BMA255_SET_BITSLICE(databuf[1],
+			BMA255_LOW_POWER_MODE, 0);
+		res += bma_i2c_write_block(client,
+			BMA255_LOW_POWER_CTRL_REG, &databuf[1], 1);
+		mdelay(1);
+		res += bma_i2c_write_block(client,
+			BMA255_MODE_CTRL_REG, &databuf[0], 1);
+		mdelay(1);
+	break;
+	}
+
+	if (res < 0) {
+		sensor_power_valid = false;
+		GSE_ERR("set power mode failed, res = %d\n", res);
+		mutex_unlock(&obj->lock);
+		return BMA255_ERR_I2C;
+	}
+	sensor_power = enable;
+	sensor_power_valid = true;
+	mutex_unlock(&obj->lock);
+
+	return BMA255_SUCCESS;
+}
+static int BMA255_SetDataFormat(struct i2c_client *client, u8 dataformat)
+{
+	struct bma255_i2c_data *obj = i2c_get_clientdata(client);
+	u8 databuf[2] = {0};
+	int res = 0;
+
+	mutex_lock(&obj->lock);
+	res = bma_i2c_read_block(client,
+		BMA255_RANGE_SEL_REG, &databuf[0], 1);
+	if (res) {
+		mutex_unlock(&obj->lock);
+		return res;
+	}
+	databuf[0] = BMA255_SET_BITSLICE(databuf[0],
+		BMA255_RANGE_SEL, dataformat);
+	res += bma_i2c_write_block(client,
+		BMA255_RANGE_SEL_REG, &databuf[0], 1);
+	mdelay(1);
+
+	if (res < 0) {
+		GSE_ERR("set data format failed, res = %d\n", res);
+		mutex_unlock(&obj->lock);
+		return BMA255_ERR_I2C;
+	}
+	mutex_unlock(&obj->lock);
+
+	return BMA255_SetDataResolution(obj);
+}
+static int BMA255_SetBWRate(struct i2c_client *client, u8 bwrate)
+{
+	u8 databuf[2] = {0};
+	int res = 0;
+	struct bma255_i2c_data *obj = i2c_get_clientdata(client);
+
+	mutex_lock(&obj->lock);
+	res = bma_i2c_read_block(client,
+		BMA255_BANDWIDTH__REG, &databuf[0], 1);
+	if (res) {
+		mutex_unlock(&obj->lock);
+		return res;
+	}
+	databuf[0] = BMA255_SET_BITSLICE(databuf[0],
+		BMA255_BANDWIDTH, bwrate);
+	res += bma_i2c_write_block(client,
+		BMA255_BANDWIDTH__REG, &databuf[0], 1);
+	mdelay(1);
+
+	if (res < 0) {
+		GSE_ERR("set bandwidth failed, res = %d\n", res);
+		mutex_unlock(&obj->lock);
+		return BMA255_ERR_I2C;
+	}
+	mutex_unlock(&obj->lock);
+
+	return BMA255_SUCCESS;
+}
+static int BMA255_SetIntEnable(struct i2c_client *client, u8 intenable)
+{
+	int res = 0;
+	struct bma255_i2c_data *obj = i2c_get_clientdata(client);
+
+	mutex_lock(&obj->lock);
+	res = bma_i2c_write_block(client, BMA255_INT_REG_1, &intenable, 0x01);
+	mdelay(1);
+	if (res != BMA255_SUCCESS) {
+		mutex_unlock(&obj->lock);
+		return res;
+	}
+
+	res = bma_i2c_write_block(client, BMA255_INT_REG_2, &intenable, 0x01);
+	mdelay(1);
+	if (res != BMA255_SUCCESS) {
+		mutex_unlock(&obj->lock);
+		return res;
+	}
+	mutex_unlock(&obj->lock);
+	GSE_LOG("BMA255 disable interrupt ...\n");
+
+	/*for disable interrupt function*/
+
+	return BMA255_SUCCESS;
+}
+
+static int bmc156_init_client(struct bma255_i2c_data *obj)
+{
+ int err;
+ err = BMA255_CheckDeviceID(obj->client);
+ if (err) return err;
+ err = BMA255_SetBWRate(obj->client, obj->bandwidth);
+ if (err) return err;
+ err = BMA255_SetDataFormat(obj->client, BMA255_RANGE_4G);
+ if (err) return err;
+ err = BMA255_SetIntEnable(obj->client, 0);
+ if (err) return err;
+ /* Force a real suspend transition at probe; no board LDO is controllable. */
+ sensor_power_valid = false;
+ err = BMA255_SetPowerMode(obj->client, obj->requested);
+ mdelay(20);
+ return err;
+}
+
+static int bmc156_enable(int en)
+{
+ int err;
+ struct bma255_i2c_data *obj = obj_i2c_data;
+ if (!obj || (en != 0 && en != 1)) return -EINVAL;
+ mutex_lock(&operation_lock);
+ if (obj->suspended) err = -EBUSY;
+ else {
+  err = BMA255_SetPowerMode(obj->client, en);
+  if (!err) obj->requested = en;
+ }
+ mutex_unlock(&operation_lock);
+ return err;
+}
+
+static int bmc156_batch(int flag, int64_t ns, int64_t latency)
+{
+ struct bma255_i2c_data *obj = obj_i2c_data;
+ int err;
+ u8 bw;
+ if (!obj || flag || latency || ns < 10000000 || ns > 200000000) return -EINVAL;
+ bw = ns <= 10000000 ? BMA255_BW_100HZ : BMA255_BW_50HZ;
+ mutex_lock(&operation_lock);
+ if (obj->suspended) err = -EBUSY;
+ else {
+  err = BMA255_SetBWRate(obj->client, bw);
+  if (!err) obj->bandwidth = bw;
+ }
+ mutex_unlock(&operation_lock);
+ return err;
+}
+
+static int bmc156_get_data(int *x, int *y, int *z, int *status)
+{
+ struct bma255_i2c_data *obj = obj_i2c_data;
+ s16 raw[3];
+ int board[3], i, err;
+ if (!obj) return -ENODEV;
+ mutex_lock(&operation_lock);
+ if (!sensor_power_valid) { err = -EIO; goto out; }
+ if (obj->suspended || !sensor_power) { err = -EAGAIN; goto out; }
+ err = BMA255_ReadData(obj->client, raw);
+ if (err) goto out;
+ /* Same OEM calibration-before-map and integer scale order. */
+ for (i = 0; i < 3; ++i)
+  board[obj->cvt.map[i]] = obj->cvt.sign[i] * (raw[i] + obj->cali_sw[i])
+                          * GRAVITY_EARTH_1000 / obj->reso->sensitivity;
+ *x = board[0]; *y = board[1]; *z = board[2];
+ *status = obj->calibrated ? SENSOR_STATUS_ACCURACY_MEDIUM : SENSOR_STATUS_UNRELIABLE;
+out:
+ mutex_unlock(&operation_lock);
+ return err;
+}
+
+/* Absolute board-coordinate raw counts; never add twice on HAL reopen. */
+static int bmc156_set_cali(uint8_t *data, uint8_t count)
+{
+ struct bma255_i2c_data *obj = obj_i2c_data;
+ s32 cal[3];
+ int i;
+ if (!obj || count != 12) return -EINVAL;
+ for (i = 0; i < 3; ++i) {
+  cal[i] = (s32)get_unaligned_le32(data + 4*i);
+  /* Exact acceptance bound in OEM bma_do_cali. */
+  if (cal[i] < -250 || cal[i] > 250) return -ERANGE;
+ }
+ mutex_lock(&operation_lock);
+ if (!sensor_power_valid) {
+  mutex_unlock(&operation_lock); return -EIO;
+ }
+ if (sensor_power || obj->suspended) {
+  mutex_unlock(&operation_lock); return -EBUSY;
+ }
+ for (i = 0; i < 3; ++i)
+  obj->cali_sw[i] = obj->cvt.sign[i] * cal[obj->cvt.map[i]];
+ obj->calibrated = true;
+ mutex_unlock(&operation_lock);
+ return 0;
+}
+
+static int bmc156_flush(void)
+{
+ int err = acc_flush_report();
+ return err == -1 ? -ENOSPC : err;
+}
+static int bmc156_local_init(void);
+static int bmc156_local_remove(void);
+static struct acc_init_info bmc156_init_info = {
+ .name = "bmc156_acc", .init = bmc156_local_init, .uninit = bmc156_local_remove,
+};
+
+static int bmc156_probe(struct i2c_client *client, const struct i2c_device_id *id)
+{
+ struct bma255_i2c_data *obj;
+ struct device_node *cust;
+ struct acc_control_path ctl = {0};
+ struct acc_data_path data = {0};
+ int err;
+ if (obj_i2c_data) return -EBUSY;
+ if (client->adapter->nr != 2 || client->addr != 0x11) return -ENODEV;
+ obj = devm_kzalloc(&client->dev, sizeof(*obj), GFP_KERNEL);
+ if (!obj) return -ENOMEM;
+ cust = of_find_compatible_node(NULL, NULL, "mediatek,bmc156_acc");
+ if (!cust) return -ENODEV;
+ err = get_accel_dts_func(cust, &obj->hw);
+ of_node_put(cust);
+ if (err) return err;
+ if (obj->hw.direction != 4 || obj->hw.power_id != -1 ||
+     obj->hw.i2c_num != 2 || obj->hw.i2c_addr[0] != 0x11 ||
+     obj->hw.power_vol || obj->hw.firlen || obj->hw.is_batch_supported) return -EINVAL;
+ err = hwmsen_get_convert(obj->hw.direction, &obj->cvt);
+ if (err) return err;
+ obj->client = client;
+ obj->bandwidth = BMA255_BW_100HZ;
+ mutex_init(&obj->lock);
+ i2c_set_clientdata(client, obj);
+ err = bmc156_init_client(obj);
+ if (err) return err;
+ obj_i2c_data = obj;
+ data.get_data = bmc156_get_data;
+ data.vender_div = 1000;
+ err = acc_register_data_path(&data);
+ if (err) goto fail;
+ ctl.enable_nodata = bmc156_enable;
+ ctl.batch = bmc156_batch;
+ ctl.flush = bmc156_flush;
+ ctl.set_cali = bmc156_set_cali;
+ ctl.is_report_input_direct = false;
+ ctl.is_support_batch = false;
+ ctl.is_use_common_factory = false;
+ err = acc_register_control_path(&ctl);
+ if (err) goto fail;
+ bma255_init_flag = 0;
+ return 0;
+fail:
+ obj_i2c_data = NULL;
+ return err;
+}
+
+static int bmc156_suspend(struct device *dev)
+{
+ struct bma255_i2c_data *obj = i2c_get_clientdata(to_i2c_client(dev));
+ int err;
+ acc_driver_pause_polling(1);
+ mutex_lock(&operation_lock);
+ err = BMA255_SetPowerMode(obj->client, false);
+ if (!err) obj->suspended = true;
+ mutex_unlock(&operation_lock);
+ if (err) acc_driver_pause_polling(0);
+ return err;
+}
+static int bmc156_resume(struct device *dev)
+{
+ struct bma255_i2c_data *obj = i2c_get_clientdata(to_i2c_client(dev));
+ int err;
+ mutex_lock(&operation_lock);
+ err = bmc156_init_client(obj);
+ if (!err) obj->suspended = false;
+ mutex_unlock(&operation_lock);
+ if (!err) acc_driver_pause_polling(0);
+ return err;
+}
+static SIMPLE_DEV_PM_OPS(bmc156_pm, bmc156_suspend, bmc156_resume);
+static const struct of_device_id bmc156_of_match[] = {
+ {.compatible = "mediatek,gsensor"}, {},
+};
+static const struct i2c_device_id bmc156_ids[] = {{"bmc156_acc", 0}, {}};
+static struct i2c_driver bmc156_driver = {
+ .driver = {.name = "bmc156_acc", .of_match_table = bmc156_of_match, .pm = &bmc156_pm, .suppress_bind_attrs = true},
+ .probe = bmc156_probe, .id_table = bmc156_ids,
+};
+static int bmc156_local_init(void)
+{
+ int err = i2c_add_driver(&bmc156_driver);
+ if (err) return err;
+ if (bma255_init_flag) { i2c_del_driver(&bmc156_driver); return bma255_init_flag; }
+ return 0;
+}
+static int bmc156_local_remove(void)
+{
+ /* Built-in only: the core has no safe unregister-data-path operation. */
+ return -EOPNOTSUPP;
+}
+static int __init bmc156_init(void)
+{
+ BUILD_BUG_ON(sizeof(struct sensor_event) != 36);
+ BUILD_BUG_ON(offsetof(struct sensor_event, word) != 12);
+ BUILD_BUG_ON(offsetof(struct sensor_event, flush_action) != 9);
+ BUILD_BUG_ON(DATA_ACTION != 0 || FLUSH_ACTION != 1);
+ return acc_driver_add(&bmc156_init_info);
+}
+module_init(bmc156_init);
+MODULE_LICENSE("GPL v2");
+MODULE_DESCRIPTION("ASUS P00A OEM BMC156 accelerometer, sensor_event ABI");
diff --git a/drivers/misc/mediatek/sensors-1.0/accelerometer/bmc156_acc/bmc156_acc.h b/drivers/misc/mediatek/sensors-1.0/accelerometer/bmc156_acc/bmc156_acc.h
